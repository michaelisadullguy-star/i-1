-- combin.hum.imo -- enumerative combinatorics: triangles of numbers, lists of combinatorial objects, permutations as numbers (human notation; lib/combin.imo is its translation, made by libsrc/build.sh).
-- It adds to the counts of lib/numtheory.imo (choose, catalan, bell, partitions, necklaces) the objects themselves and more counts.  Permutations are lists that contain 0 to n-1 once each.
_cblet(x, f) in alpha -> (alpha -> beta) -> beta := f(x)
_cbadd(a, b) in \NN -> \NN -> \NN := a + b
_cbmul(a, b) in \NN -> \NN -> \NN := a * b
_cbnth(xs, k) in List(\NN) -> \NN -> \NN := if(k lt length(xs), nth(xs, k), 0)
-- Pascal's triangle and relatives
_cbpnext(row) in List(\NN) -> List(\NN) := zipwith(_cbadd, cons(0, row), row ++ [0])
pascalrow(n) in \NN -> List(\NN) := applyn(n, _cbpnext, [1])
_cbptri(row, n) in List(\NN) -> \NN -> List(List(\NN)) := if(n == 0, [], cons(row, _cbptri(_cbpnext(row), abs(n - 1))))
pascaltriangle(n) in \NN -> List(List(\NN)) := _cbptri([1], n)
multinomial(ks) in List(\NN) -> \NN := factorial(sumof(ks)) div foldl(_cbmul, 1, map(factorial, ks))
multichoose(n, k) in \NN -> \NN -> \NN := if(n == 0, if(k == 0, 1, 0), choose(abs(n + k - 1), k))
fallingfactorial(n, k) in \NN -> \NN -> \NN := if(k gt n, 0, factorial(n) div factorial(abs(n - k)))
risingfactorial(n, k) in \NN -> \NN -> \NN := if(k == 0, 1, if(n == 0, 0, factorial(abs(n + k - 1)) div factorial(abs(n - 1))))
-- counts
derangements(n) in \NN -> \NN := if(n == 0, 1, abs(n * derangements(abs(n - 1)) + (if(n mod 2 == 0, 1, 0 - 1))))
rencontres(n, k) in \NN -> \NN -> \NN := if(k gt n, 0, choose(n, k) * derangements(abs(n - k)))
_cbeunext(m, row) in \NN -> List(\NN) -> List(\NN) := map((k in \NN |-> (k + 1) * _cbnth(row, k) + abs(m - k) * (if(k == 0, 0, _cbnth(row, abs(k - 1))))), upto(0, abs(m - 1)))
_cbeuiter(m, n, row) in \NN -> \NN -> List(\NN) -> List(\NN) := if(m gt n, row, _cbeuiter(m + 1, n, _cbeunext(m, row)))
eulerianrow(n) in \NN -> List(\NN) := _cbeuiter(1, n, [1])
eulerian(n, k) in \NN -> \NN -> \NN := _cbnth(eulerianrow(n), k)
narayana(n, k) in \NN -> \NN -> \NN := if((k == 0) or (k gt n), 0, (choose(n, k) * choose(n, abs(k - 1))) div n)
motzkin(n) in \NN -> \NN := sumof(map((k in \NN |-> choose(n, 2 * k) * catalan(k)), upto(0, n div 2)))
schroeder(n) in \NN -> \NN := sumof(map((k in \NN |-> (choose(n, k) * choose(n + k, k)) div (k + 1)), upto(0, n)))
-- lists of objects: compositions (lexicographic), partitions (largest part first), Dyck words (U up, D down; lexicographic with D before U), Lyndon words (lexicographic)
compositions(n) in \NN -> List(List(\NN)) := if(n == 0, [[]], concatmap((k in \NN |-> map((c in List(\NN) |-> cons(k, c)), compositions(abs(n - k)))), upto(1, n)))
_cbplist(n, m) in \NN -> \NN -> List(List(\NN)) := if(n == 0, [[]], concatmap((k in \NN |-> map((c in List(\NN) |-> cons(k, c)), _cbplist(abs(n - k), k))), reverse(upto(1, if(n lt m, n, m)))))
partitionlist(n) in \NN -> List(List(\NN)) := _cbplist(n, n)
_cbdy(u, h) in \NN -> \NN -> List(String) := if((u == 0) and (h == 0), [""], (if(h gt 0, map((w in String |-> "D" ++ w), _cbdy(u, abs(h - 1))), [])) ++ (if(u gt 0, map((w in String |-> "U" ++ w), _cbdy(abs(u - 1), h + 1)), [])))
dyckpaths(n) in \NN -> List(String) := _cbdy(n, 0)
_cbcycle(w, n) in List(\NN) -> \NN -> List(\NN) := map((i in \NN |-> nth(w, i mod length(w))), upto(0, abs(n - 1)))
_cbstrip(w, k) in List(\NN) -> \NN -> List(\NN) := if(isnil(w), [], if(last(w) == abs(k - 1), _cbstrip(init(w), k), w))
_cblyn(w, n, k) in List(\NN) -> \NN -> \NN -> List(List(\NN)) := (if(length(w) == n, [w], [])) ++ _cblet(_cbstrip(_cbcycle(w, n), k), (v in List(\NN) |-> if(isnil(v), [], _cblyn(init(v) ++ [last(v) + 1], n, k))))
lyndonwords(n, k) in \NN -> \NN -> List(List(\NN)) := if((n == 0) or (k == 0), [], _cblyn([0], n, k))
-- permutations: the Lehmer code (for each place, how many later entries are smaller), the lexicographic rank, and back
lehmer(p) in List(\NN) -> List(\NN) := if(isnil(p), [], cons(length(filter((x in \NN |-> x lt head(p)), tail(p))), lehmer(tail(p))))
_cbrm(i, xs) in \NN -> List(\NN) -> List(\NN) := take(i, xs) ++ drop(i + 1, xs)
_cbunleh(code, avail) in List(\NN) -> List(\NN) -> List(\NN) := if(isnil(code), [], cons(nth(avail, head(code)), _cbunleh(tail(code), _cbrm(head(code), avail))))
unlehmer(code) in List(\NN) -> List(\NN) := _cbunleh(code, upto(0, abs(length(code) - 1)))
_cbrank(code) in List(\NN) -> \NN := if(isnil(code), 0, head(code) * factorial(abs(length(code) - 1)) + _cbrank(tail(code)))
permrank(p) in List(\NN) -> \NN := _cbrank(lehmer(p))
_cbfd(m, r) in \NN -> \NN -> List(\NN) := if(m == 0, [], _cblet(factorial(abs(m - 1)), (f in \NN |-> cons(r div f, _cbfd(abs(m - 1), r mod f)))))
permunrank(n, r) in \NN -> \NN -> List(List(\NN)) := if(r lt factorial(n), [unlehmer(_cbfd(n, r))], [])
nextperm(p) in List(\NN) -> List(List(\NN)) := _cblet(permrank(p) + 1, (r in \NN |-> permunrank(length(p), r)))
inversions(p) in List(\NN) -> \NN := sumof(lehmer(p))
descents(p) in List(\NN) -> \NN := if(isnil(p), 0, sumof(zipwith((a in \NN |-> (b in \NN |-> if(a gt b, 1, 0))), p, tail(p))))
permsign(p) in List(\NN) -> \ZZ := if(inversions(p) mod 2 == 0, 1, 0 - 1)
-- all set partitions of a list, as lists of blocks: the first element is a block of its own, or joins one of the blocks of a partition of the rest
_cbins(x, q, i) in alpha -> List(List(alpha)) -> \NN -> List(List(alpha)) := take(i, q) ++ [cons(x, nth(q, i))] ++ drop(i + 1, q)
_cbwith(x, q) in alpha -> List(List(alpha)) -> List(List(List(alpha))) := cons(cons([x], q), map((i in \NN |-> _cbins(x, q, i)), if(isnil(q), [], upto(0, abs(length(q) - 1)))))
setpartitions(xs) in List(alpha) -> List(List(List(alpha))) := if(isnil(xs), [[]], concatmap((q in List(List(alpha)) |-> _cbwith(head(xs), q)), setpartitions(tail(xs))))
