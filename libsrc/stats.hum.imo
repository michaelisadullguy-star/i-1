-- stats.hum.imo -- exact statistics on lists of rational numbers (human notation; lib/stats.imo is its translation, made by libsrc/build.sh).
-- Every result is an exact rational; the variance is the population variance, svariance the sample variance; correlation2 is the square of Pearson's coefficient (no square root is needed).
_slet(x, f) in alpha -> (alpha -> beta) -> beta := f(x)
total(xs) in List(\QQ) -> \QQ := sumof(xs)
average(xs) in List(\QQ) -> \QQ := if(isnil(xs), 0, sumof(xs) / length(xs))
spread(xs) in List(\QQ) -> \QQ := if(isnil(xs), 0, maximum(xs) - minimum(xs))
_medsorted(s, k) in List(\QQ) -> \NN -> \QQ := if((length(s) mod 2) == 1, nth(s, k), (nth(s, k) + last(take(k, s))) / 2)
median(xs) in List(\QQ) -> \QQ := if(isnil(xs), 0, _medsorted(sort(xs), length(xs) div 2))
modes(xs) in List(\QQ) -> List(\QQ) := if(isnil(xs), [], map((p in Pair(\QQ, \NN) |-> fst(p)), filter((p in Pair(\QQ, \NN) |-> snd(p) == maximum(map((q in Pair(\QQ, \NN) |-> snd(q)), tally(xs)))), tally(xs))))
variance(xs) in List(\QQ) -> \QQ := if(isnil(xs), 0, _slet(average(xs), (m in \QQ |-> sumof(map((x in \QQ |-> (x - m) * (x - m)), xs)) / length(xs))))
svariance(xs) in List(\QQ) -> \QQ := if(length(xs) leq 1, 0, _slet(average(xs), (m in \QQ |-> sumof(map((x in \QQ |-> (x - m) * (x - m)), xs)) / (length(xs) - 1))))
_qinterp(s, h) in List(\QQ) -> \QQ -> \QQ := _slet(abs(floor(h)), (lo in \NN |-> nth(s, lo) + (h - lo) * (nth(s, min(lo + 1, abs(length(s) - 1))) - nth(s, lo))))
quantile(p, xs) in \QQ -> List(\QQ) -> \QQ := if(isnil(xs), 0, _qinterp(sort(xs), (length(xs) - 1) * p))
iqr(xs) in List(\QQ) -> \QQ := quantile(3 / 4, xs) - quantile(1 / 4, xs)
covariance(xs, ys) in List(\QQ) -> List(\QQ) -> \QQ := if(isnil(xs) or isnil(ys), 0, sumof(zipwith((x in \QQ |-> (y in \QQ |-> x * y)), xs, ys)) / min(length(xs), length(ys)) - average(take(min(length(xs), length(ys)), xs)) * average(take(min(length(xs), length(ys)), ys)))
correlation2(xs, ys) in List(\QQ) -> List(\QQ) -> \QQ := if((variance(xs) == 0) or (variance(ys) == 0), 0, covariance(xs, ys) * covariance(xs, ys) / (variance(xs) * variance(ys)))
linreg(xs, ys) in List(\QQ) -> List(\QQ) -> Pair(\QQ, \QQ) := if(variance(xs) == 0, pair(0, average(ys)), pair(covariance(xs, ys) / variance(xs), average(ys) - covariance(xs, ys) / variance(xs) * average(xs)))
cumsum(xs) in List(\QQ) -> List(\QQ) := scanl1((a in \QQ |-> (b in \QQ |-> a + b)), xs)
movingavg(k, xs) in \NN -> List(\QQ) -> List(\QQ) := if(k == 0, [], map((w in List(\QQ) |-> sumof(w) / k), windows(k, xs)))
weightedmean(ws, xs) in List(\QQ) -> List(\QQ) -> \QQ := if(sumof(ws) == 0, 0, sumof(zipwith((w in \QQ |-> (x in \QQ |-> w * x)), ws, xs)) / sumof(ws))
ranks(xs) in List(\QQ) -> List(\QQ) := map((x in \QQ |-> count((y in \QQ |-> y lt x), xs) + (count((y in \QQ |-> y == x), xs) + 1) / 2), xs)
