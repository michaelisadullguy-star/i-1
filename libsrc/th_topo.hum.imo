-- th_topo.hum.imo -- the packages topology, monoid and cmonoid (generated by libsrc/gen/th_topo.py; human notation; lib/th_topo.imo is its translation).
thtopologysig in List(String) := lines("fn 0 cl cl\nfn 0 int interior\nfn 0 bd bd\nfn 0 ext ext\nfn 0 open open\nfn 0 closed closed")
thtopologyrules in List(String) := lines("cl(false) ==> false\ncl(true) ==> true\ncl(or(x, y)) ==> or(cl(x), cl(y))\ncl(cl(x)) ==> cl(x)\ncl(not(cl(not(cl(not(cl(x))))))) ==> cl(not(cl(x)))\ninterior(x) ==> not(cl(not(x)))\nbd(x) ==> and(cl(x), cl(not(x)))\next(x) ==> not(cl(x))\nopen(x) ==> subset(x, not(cl(not(x))))\nclosed(x) ==> subset(cl(x), x)\nor(x, cl(x)) ==> cl(x)\nand(x, cl(x)) ==> x\nor(x, cl(not(x))) ==> true\nor(not(x), cl(x)) ==> true\nor(x, not(cl(not(x)))) ==> x\nand(x, not(cl(not(x)))) ==> not(cl(not(x)))\nsubset(x, cl(x)) ==> true\nsubset(not(cl(not(x))), x) ==> true\nsubset(cl(and(x, y)), and(cl(x), cl(y))) ==> true\nsubset(not(cl(not(x))), cl(x)) ==> true\nsubset(cl(not(cl(not(x)))), cl(x)) ==> true\nsubset(not(cl(not(x))), not(cl(not(cl(x))))) ==> true\nsubset(or(not(cl(not(x))), not(cl(not(y)))), not(cl(not(or(x, y))))) ==> true\ncl(and(cl(x), cl(y))) ==> and(cl(x), cl(y))\nor(x, and(cl(x), cl(not(x)))) ==> cl(x)\nand(x, or(not(cl(x)), not(cl(not(x))))) ==> not(cl(not(x)))")
thtopologyaxioms in List(String) := lines("a topological space is a set U with a closure operator cl on its subsets (Kuratowski, 1922):\nK1 cl(∅) = ∅\nK2 A ⊆ cl(A)\nK3 cl(A ∪ B) = cl(A) ∪ cl(B)\nK4 cl(cl(A)) = cl(A)\nequivalently, by the open sets: ∅ and U are open; a union of open sets is open; an intersection of two open sets is open (the closed sets are the complements of the open sets)\nthe interior is int(A) = (cl(Aᶜ))ᶜ, the boundary is bd(A) = cl(A) ∩ cl(Aᶜ), the exterior is ext(A) = (cl(A))ᶜ; A is open if A = int(A), closed if A = cl(A)\nconsequences used by the simplifier: cl is monotone and cl(A ∩ B) ⊆ cl(A) ∩ cl(B); int(A ∩ B) = int(A) ∩ int(B); and the theorem of Kuratowski: the closure and the complement generate at most 14 different operations: k k = k, c c = 1 and k c k c k c k = k c k\nthe simplifier rewrites int, bd and ext into cl and complements, so that every statement about them is a statement of the algebra of sets about closures")
thtopologytheorems in List(String) := lines("cl(cl(A)) = cl(A)\nint(int(A)) = int(A)\nint(A) = (cl(Aᶜ))ᶜ\ncl(A) = (int(Aᶜ))ᶜ\ncl(A ∪ B) = cl(A) ∪ cl(B)\nint(A ∩ B) = int(A) ∩ int(B)\ncl(∅) = ∅\ncl(U) = U\nint(∅) = ∅\nint(U) = U\ncl(int(cl(int(A)))) = cl(int(A))\nint(cl(int(cl(A)))) = int(cl(A))\nbd(A) = bd(Aᶜ)\nbd(A) = cl(A) \\ int(A)\next(A) = int(Aᶜ)\nint(A) ∩ bd(A) = ∅\nint(A) ∪ bd(A) ∪ ext(A) = U\ncl(A) = A ∪ bd(A)\nint(A) = A \\ bd(A)\ncl(bd(A)) = bd(A)\nbd(bd(A)) ⊆ bd(A)\nA ⊆ cl(A)\nint(A) ⊆ A\nint(A) ⊆ cl(A)\ncl(A ∩ B) ⊆ cl(A) ∩ cl(B)\nint(A) ∪ int(B) ⊆ int(A ∪ B)\ncl(int(A)) ⊆ cl(A)\nint(A) ⊆ int(cl(A))\nopen(int(A))\nclosed(cl(A))\nopen(A) <=> closed(Aᶜ)\nopen(A) && open(B) => open(A ∩ B)\nclosed(A) && closed(B) => closed(A ∪ B)\ncl(A) ⊆ A <=> closed(A)\ncl(A) ∩ cl(Aᶜ) = bd(A)\nbd(A) ∩ ext(A) = ∅\nbd(A) ∩ A = ∅ => open(A)\nclosed(bd(A))\nclosed(A) => closed(cl(A))\nopen(∅)\nopen(U)\nclosed(∅)\nclosed(U)\nint(cl(A)) ⊆ cl(A)\next(ext(A)) = int(cl(A))\nbd(A ∩ B) = (cl(A ∩ B)) \\ int(A ∩ B)")
thtopologydoc in String := "topological spaces by the Kuratowski closure axioms: closure, interior, boundary and exterior as operators on the algebra of sets, with the normal forms of the 14-set theorem; requires sets"
thtopology in Theory := mktheory("topology", ["sets"], [], false, thtopologysig, thtopologyrules, [], thtopologyaxioms, thtopologytheorems, thtopologydoc)
thmonoidsig in List(String) := lines("infixl 7 ⋆ mop A\ninfixl 7 mop mop A\nconst 0 ε munit\nconst 0 munit munit")
thmonoidrules in List(String) := lines("mop(x, munit) ==> x\nmop(munit, x) ==> x")
thmonoidaxioms in List(String) := lines("a monoid is a set with an associative operation ⋆ and a neutral element ε:\nM1 (x ⋆ y) ⋆ z = x ⋆ (y ⋆ z)\nM2 x ⋆ ε = x\nM3 ε ⋆ x = x\nnothing else is assumed: the operation need not be commutative (the words are free monoid words), and there is no cancellation: x ⋆ y = x ⋆ z does not give y = z; the package group adds inverses")
thmonoidtheorems in List(String) := lines("(x ⋆ y) ⋆ z = x ⋆ (y ⋆ z)\nx ⋆ ε = x\nε ⋆ x = x\nε ⋆ ε = ε\nx ⋆ ε ⋆ y = x ⋆ y\nx ⋆ y ⋆ z ⋆ w = (x ⋆ y) ⋆ (z ⋆ w)\n(x ⋆ y) ⋆ ε = x ⋆ y\nx ⋆ (ε ⋆ y ⋆ ε) = x ⋆ y\nx ⋆ y = y ⋆ x <=> x ⋆ y = y ⋆ x\nx ⋆ x ⋆ x = x ⋆ (x ⋆ x)")
thmonoiddoc in String := "monoids: an associative operation with a neutral element, the words of the free monoid; no commutativity and no cancellation"
thmonoid in Theory := mktheory("monoid", ["core"], ["cmonoid"], false, thmonoidsig, thmonoidrules, [], thmonoidaxioms, thmonoidtheorems, thmonoiddoc)
thcmonoidsig in List(String) := lines("infixl 7 ⋆ mop AC\ninfixl 7 mop mop AC\nconst 0 ε munit\nconst 0 munit munit")
thcmonoidrules in List(String) := lines("mop(x, munit) ==> x\nmop(munit, x) ==> x")
thcmonoidaxioms in List(String) := lines("a commutative monoid is a monoid whose operation is commutative:\nM1 (x ⋆ y) ⋆ z = x ⋆ (y ⋆ z)\nM2 x ⋆ ε = x\nM3 ε ⋆ x = x\nM4 x ⋆ y = y ⋆ x\nthe words are multisets: x ⋆ y ⋆ x = x ⋆ x ⋆ y, but still x ⋆ x ≠ x (that is a semilattice)")
thcmonoidtheorems in List(String) := lines("x ⋆ y = y ⋆ x\nx ⋆ y ⋆ z = z ⋆ y ⋆ x\nx ⋆ y ⋆ x = x ⋆ x ⋆ y\nx ⋆ ε = x\n(x ⋆ y) ⋆ (z ⋆ w) = (x ⋆ z) ⋆ (y ⋆ w)\nx ⋆ y ⋆ ε ⋆ z = z ⋆ x ⋆ y")
thcmonoiddoc in String := "commutative monoids: the words are multisets; excludes monoid"
thcmonoid in Theory := mktheory("cmonoid", ["core"], ["monoid"], false, thcmonoidsig, thcmonoidrules, [], thcmonoidaxioms, thcmonoidtheorems, thcmonoiddoc)
