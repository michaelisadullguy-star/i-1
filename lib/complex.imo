bjS_cx ν ξ ≔ ((⩾ ν 0) ((≐ ξ 0) ((≐ ν 0) (⁂ 1) (⁂ 0)) (sEs_cx (÷ (^ (÷ ξ 1100) ν) (fact ν)) (κ ↦ (÷ (⊖ (⊠ ξ ξ)) (⊠ 111010000 (⊠ κ (⊞ κ ν))))) (κ ↦ (lg2_cx (÷ (𝒩 ξ) (⊠ 111010000 (⊠ κ κ))))) (bz_cx ξ))) ((θ ↦ ((≐ (mod ν 1100) 0) θ (negR_cx θ))) (bjS_cx (⊖ ν) ξ)))
⍝ ---- sine and cosine integrals, exponential integral, logarithmic integral
⍝ Si z = Σ (−1)ᵏ z^(2k+1)/((2k + 1)(2k + 1)!):  ratio −z²(2k − 1)/(2k(2k + 1)²), |ratio| ≤ |z|²/(4k²)
siS_cx ∶ ℚ[i] → ℝ[i]
siS_cx ξ ≔ ((≐ ξ 0) (⁂ 0) (sEs_cx ξ (κ ↦ (÷ (⊠ (⊖ (⊠ ξ ξ)) (⊟ (⊠ 1100 κ) 1)) (⊠ (⊠ 1100 κ) (⊠ (⊞ (⊠ 1100 κ) 1) (⊞ (⊠ 1100 κ) 1))))) (κ ↦ (lg2_cx (÷ (𝒩 ξ) (⊠ 111010000 (⊠ κ κ))))) (bz_cx ξ)))
⍝ Ci z = γ + log z + Σₖ≥₁ (−1)ᵏ z^(2k)/(2k(2k)!):  first term −z²/4, ratio −z²·2k/((2k + 2)²(2k + 1)), |ratio| ≤ |z|²/(4k²)
ciS_cx ∶ ℚ[i] → ℝ[i]
ciS_cx ξ ≔ ((≐ ξ 0) (⁂ 0) (sumR_cx (sumR_cx 𝛾 (logS_cx ξ)) (sEs_cx (÷ (⊖ (⊠ ξ ξ)) 111010000) (κ ↦ (÷ (⊠ (⊖ (⊠ ξ ξ)) (⊠ 1100 κ)) (⊠ (⊠ (⊞ (⊠ 1100 κ) 1100) (⊞ (⊠ 1100 κ) 1100)) (⊞ (⊠ 1100 κ) 1)))) (κ ↦ (lg2_cx (÷ (𝒩 ξ) (⊠ 111010000 (⊠ κ κ))))) (bz_cx ξ))))
⍝ Ein*(u) = Σₖ≥₁ uᵏ/(k·k!) for an exact real u:  ratio u·k/(k + 1)², |ratio| ≤ |u|/k, products ≤ e^|u|
einS_cx ∶ ℚ → ℝ
einS_cx ξ ≔ ((≐ ξ 0) (⁂ 0) (sEs_cx ξ (κ ↦ (÷ (⊠ ξ κ) (⊠ (⊞ κ 1) (⊞ κ 1)))) (κ ↦ (lg2_cx (÷ (abs ξ) κ))) (⊞ (⌈ (abs ξ)) 1)))
⍝ Ei x = γ + log|x| + Ein*(x) (x real ≠ 0)
eiS_cx ∶ ℚ → ℝ
eiS_cx ξ ≔ ((≐ ξ 0) (⁂ 0) (sumR_cx (sumR_cx 𝛾 (lpS_cx (abs ξ))) (einS_cx ξ)))
⍝ Ein* of a real stream U: |d/du Ein*(u)| = |(eᵘ − 1)/u| ≤ e^|u| ≤ 2^(c−2), c = ⌈3/2·(|U₀| + 1)⌉ + 3 (|U − U₀| ≤ 2⁻⁸), so U is taken at m + c
einR_cx ∶ ℝ → ℝ
einR_cx ξ ≔ ((ν ↦ (mk_cx (μ ↦ (at_cx (einS_cx (ℜ (at_cx ξ (⊞ μ ν)))) (⊞ μ 1))))) (⊞ (⌈ (⊠ (÷ 1101 1100) (⊞ (abs (ℜ (at_cx ξ 0))) 1))) 1101))
⍝ li x = Ei(log x) = γ + log|log x| + Ein*(log x)  (x > 0, x ≠ 1)
liS_cx ∶ ℚ → ℝ
liS_cx ξ ≔ ((∨ (⩽ ξ 0) (≐ ξ 1)) (⁂ 0) ((υ ↦ (sumR_cx (sumR_cx 𝛾 (logR_cx (⫶ (θ ↦ (abs (ℜ θ))) υ))) (einR_cx υ))) (lpS_cx ξ)))
⍝ ---- the Lambert W function, principal branch, for a real x ≥ −1/e: Newton's step w ← (w²eʷ + x)/(eʷ(1 + w)) on f(w) = w·eʷ − x
⍝ (convex and increasing on (−1, ∞), so from any start above −1 the steps go above W and then down to it), each at a working
⍝ precision P = m + 8 + ⌈log₂ 1/(1 + w)⌉⁺ + ⌈log₂ |w|⌉⁺, until the residual R = |f(w)| + |w|·2⁻ᴾ⁻² (eʷ within 2⁻ᴾ⁻²) certifies
⍝ |W − w| < d = 2⁻ᵐ⁻²:  either d ≤ (1 + w)/2 and R < d·(eʷ − 2⁻ᴾ⁻²)(1 + w)/4 (f′ ≥ e^(w−d)(1 + w − d) ≥ eʷ(1 + w)/4 on [w − d, w + d],
⍝ so f changes sign there), or f(w) > |w|·2⁻ᴾ⁻² (w > W) and 1 + w ≤ d (W > −1).  Start: log(1 + x) (to 4 bits) for x ≥ 0,
⍝ −1 + p − p²/3 with p ≈ √(2(1 + e·x)) for x < 0 (both above −1).
lwn_cx ∶ ℚ → ℚ → ℕ → ℚ
lwn_cx ξ ω ν ≔ ((η ↦ ((θ ↦ ((leq_cx (⊞ 1 θ) (^ 1100 (⊖ ν))) (⊟ (^ 1100 (⊖ ν)) 1) θ)) (tr_cx (qdiv_cx (qadd_cx (qmul_cx (qmul_cx ω ω) η) ξ) (qmul_cx η (⊞ 1 ω))) ν))) (ℜ (expq_cx ω (⊞ ν 1100))))
lwl_cx ∶ ℚ → ℕ → ℚ → ℕ → ℚ
lwl_cx ξ μ ω ν ≔ ((ϕ ↦ ((lt_cx ν ϕ) (lwl_cx ξ μ (lwn_cx ξ ω ν) (⊠ 1100 ν)) ((ϕ ↦ ((ε ↦ ((ε′ ↦ ((η ↦ ((ρ ↦ ((δ ↦ ((∨ (∧ (leq_cx δ (÷ (⊞ 1 ω) 1100)) (lt_cx (⊞ (abs ρ) (⊠ (abs ω) ε′)) (⊠ (⊠ δ (⊟ η ε′)) (÷ (⊞ 1 ω) 111010000)))) (∧ (lt_cx (⊠ (abs ω) ε′) ρ) (leq_cx (⊞ 1 ω) δ))) (tr_cx ω (⊞ μ 1100)) ((ω′ ↦ (lwl_cx ξ μ ((leq_cx (⊞ 1 ω′) ε) (⊟ ε 1) ω′) ϕ)) (tr_cx (qdiv_cx (qadd_cx (qmul_cx (qmul_cx ω ω) η) ξ) (qmul_cx η (⊞ 1 ω))) ϕ)))) (^ 1100 (⊖ (⊞ μ 1100))))) (qsub_cx (qmul_cx ω η) ξ))) (ℜ (expq_cx ω (⊞ ϕ 1100))))) (^ 1100 (⊖ (⊞ ϕ 1100))))) (^ 1100 (⊖ ϕ)))) ϕ))) (⊞ (⊞ (⊞ μ 111000000) (max 0 (⊖ (lgl_cx (⊞ 1 ω))))) (ub_cx ω)))
⍝ x < −1/e?  (decided with e to ever more bits: e·x + 1 ≠ 0 for a rational x)
lwdom_cx ∶ ℚ → ℕ → 𝔹
lwdom_cx ξ ν ≔ ((υ ε ↦ ((lt_cx ε υ) ⊥ ((lt_cx υ (⊖ ε)) ⊤ (lwdom_cx ξ (⊞ ν 111000000))))) (⊞ (⊠ ξ (ℜ (at_cx ℯ ν))) 1) (⊠ (abs ξ) (^ 1100 (⊖ ν))))
lwq_cx ∶ ℚ → ℕ → ℚ
lwq_cx ξ μ ≔ (lwl_cx ξ μ ((⩾ ξ 0) (tr_cx (logpos_cx (⊞ 1 ξ) 111010000) 111010000) ((θ ↦ (tr_cx (⊟ (⊟ θ 1) (÷ (⊠ θ θ) 1101)) 111000000)) (sqrtpos_cx (max (÷ 1 (^ 1100 110011010000)) (⊠ 1100 (⊞ 1 (⊠ ξ (ℜ (at_cx ℯ 111000000)))))) 111000000))) 111000000)
lwS_cx ∶ ℚ → ℝ
lwS_cx ξ ≔ ((≐ ξ 0) (⁂ 0) ((∧ (lt_cx ξ (÷ 11101 111010000)) (lwdom_cx ξ 111000000)) (⁂ 0) (mkq_cx (lwq_cx ξ))))
⍝ ---- the arithmetic–geometric mean of reals a, b ≥ 0 with outward rounding: M is increasing in both arguments and invariant under
⍝ (a, b) ↦ ((a + b)/2, √(ab)), so bounds a⁻ ≤ a ≤ a⁺, b⁻ ≤ b ≤ b⁺ carried with downward and upward rounding keep
⍝ min(a⁻, b⁻) ≤ M ≤ max(a⁺, b⁺).  The loop stops when the midpoints of the a and b intervals are within 2^(4−q) (the AGM has
⍝ converged; the interval is then about 4n·2⁻ᵠ wide after n steps), or after 64 steps.  It also carries, for E(m),
⍝ S = Σₙ 2^(n−1)·cₙ² with c₍ₙ₊₁₎ = (aₙ − bₙ)/2 as an interval [s⁻, s⁺] (τ = 2ⁿ), and passes κ lo hi s⁻ s⁺ τ to its continuation.
⍝ rounding down and up: tr(x ∓ 2^(1−q), q) is within 2⁻ᵠ of x ∓ 2^(1−q), so it lies below (above) x, and its digits stay short
dn_cx ∶ ℚ → ℕ → ℚ
dn_cx ξ μ ≔ (max 0 (dnr_cx ξ μ))
dnr_cx ∶ ℚ → ℕ → ℚ
dnr_cx ξ μ ≔ (ℜ (tr_cx (⊟ ξ (^ 1100 (⊟ 1 μ))) μ))
up_cx ∶ ℚ → ℕ → ℚ
up_cx ξ μ ≔ (ℜ (tr_cx (⊞ ξ (^ 1100 (⊟ 1 μ))) μ))
sq2_cx ∶ ℚ → ℚ → ℚ
sq2_cx ξ η ≔ ((⩽ ξ 0) ((⩾ η 0) 0 (⊠ η η)) (⊠ ξ ξ))
agl_cx ∶ ℕ → ℕ → ℚ → ℚ → ℚ → ℚ → ℚ → ℚ → ℚ → (ℚ → ℚ → ℚ → ℚ → ℚ → β) → β
agl_cx μ ι τ α₁ α₂ β₁ β₂ σ₁ σ₂ κ ≔ ((λ υ ↦ ((∨ (⩽ (abs (⊟ (⊞ α₁ α₂) (⊞ β₁ β₂))) (^ 1100 (⊟ 111010001 μ))) (⩾ ι 11101000000000000)) (κ λ υ σ₁ σ₂ τ) ((ϕ ψ ↦ (agl_cx μ (⊞ ι 1) (⊠ 1100 τ) (dn_cx (÷ (⊞ α₁ β₁) 1100) μ) (up_cx (÷ (⊞ α₂ β₂) 1100) μ) (dn_cx (sqrtpos_cx (⊠ α₁ β₁) (⊞ μ 1)) μ) (up_cx (sqrtpos_cx (⊠ α₂ β₂) (⊞ μ 1)) μ) (dnr_cx (⊞ σ₁ (⊠ τ (sq2_cx ϕ ψ))) μ) (up_cx (⊞ σ₂ (⊠ τ (max (⊠ ϕ ϕ) (⊠ ψ ψ)))) μ) κ)) (dnr_cx (÷ (⊟ α₁ β₂) 1100) μ) (up_cx (÷ (⊟ α₂ β₁) 1100) μ)))) (min α₁ β₁) (max α₂ β₂))
⍝ a regular-stream element from an interval (first at q = m + 12): retry with 8 more bits until hi − lo ≤ 2⁻ᵐ⁻¹, then the midpoint truncated at m + 2
⍝ (φ q gives the pair (lo, hi) at working precision q)
ivl_cx ∶ (ℕ → 𝔓 ℚ ℚ) → ℕ → ℕ → ℚ
ivl_cx φ μ ν ≔ ((θ ↦ ((⩽ (⊟ (▶ θ) (◀ θ)) (^ 1100 (⊖ (⊞ μ 1)))) (tr_cx (÷ (⊞ (◀ θ) (▶ θ)) 1100) (⊞ μ 1100)) (ivl_cx φ μ (⊞ ν 111000000)))) (φ ν))
⍝ M(a, b) for a, b ≥ 0
agmq_cx ∶ ℚ → ℚ → ℕ → ℚ
agmq_cx ξ η μ ≔ (ivl_cx (ν ↦ (agl_cx ν 0 1 ξ ξ η η 0 0 (λ υ σ₁ σ₂ τ ↦ (⊗ λ υ)))) μ (⊞ μ 100010000))
⍝ K(m) = π/(2·M(1, √(1 − m))) and E(m) = K(m)·(1 − S), S = m/2 + Σₙ≥₁ 2^(n−1)·cₙ² (m < 1).  The tail after the loop is at most
⍝ 2τh² (h = (hi − lo)/2 ≥ |c₍ₙ₊₁₎|, as c₍ⱼ₊₁₎ ≤ cⱼ²/(4M) falls by 4 or more once h ≤ lo); with π within 2⁻ᵠ:
⍝ K ∈ [π⁻/(2hi), π⁺/(2lo)],  E ∈ [π⁻(1 − S⁺)/(2hi) (or 0 if 1 − S⁺ < 0), π⁺(1 − S⁻)/(2lo)].  An interval that is not yet certified
⍝ (lo = 0, or h > lo) is made as wide as [0, 1 + K⁺] so that the retry takes over.
ekl_cx ∶ ℚ → ℕ → (ℚ → ℚ → ℚ → ℚ → ℚ → ℚ → ℚ → 𝔓 ℚ ℚ) → 𝔓 ℚ ℚ
ekl_cx ξ ν κ ≔ ((θ ↦ (agl_cx ν 0 1 1 1 (max 0 (⊟ θ (^ 1100 (⊖ ν)))) (⊞ θ (^ 1100 (⊖ ν))) (÷ ξ 1100) (÷ ξ 1100) (κ (⊟ (pia_cx ν) (^ 1100 (⊖ ν))) (⊞ (pia_cx ν) (^ 1100 (⊖ ν)))))) (sqrtpos_cx (⊟ 1 ξ) ν))
ekq_cx ∶ ℚ → ℕ → ℚ
ekq_cx ξ μ ≔ (ivl_cx (ν ↦ (ekl_cx ξ ν (π₁ π₂ λ υ σ₁ σ₂ τ ↦ ((⩽ λ 0) (⊗ 0 (^ 1100 μ)) (⊗ (÷ π₁ (⊠ 1100 υ)) (÷ π₂ (⊠ 1100 λ))))))) μ (⊞ μ 100010000))
eeq_cx ∶ ℚ → ℕ → ℚ
eeq_cx ξ μ ≔ (ivl_cx (ν ↦ (ekl_cx ξ ν (π₁ π₂ λ υ σ₁ σ₂ τ ↦ ((θ ↦ ((∨ (⩽ λ 0) (lt_cx λ θ)) (⊗ 0 (^ 1100 μ)) ((σ₃ ↦ (⊗ ((⩾ σ₃ 1) 0 (÷ (⊠ π₁ (⊟ 1 σ₃)) (⊠ 1100 υ))) (÷ (⊠ π₂ (⊟ 1 σ₁)) (⊠ 1100 λ)))) (⊞ σ₂ (⊠ (⊠ 1100 τ) (⊠ θ θ)))))) (÷ (⊟ υ λ) 1100))))) μ (⊞ μ 100010000))
⍝ ==== the special functions (public)
absc ∶ ℚ[i] → ℝ   ⍝ modulus |z| = √(x² + y²) of an exact complex number; element n within 2⁻ⁿ
absc ξ ≔ (spS_cx (𝒩 ξ))
Γ ∶ ℚ → ℝ   ⍝ gamma function Γ(z): Stirling's series (exact Bernoulli numbers, remainder ≤ first omitted term) after the shift Γ(z) = Γ(z + N)/(z(z + 1)⋯(z + N − 1)); 0 at the poles 0, −1, −2, …; element n within 2⁻ⁿ; the cost grows with |z|
Γ ∶ ℚ[i] → ℝ[i]
Γ ξ ≔ (rel_cx ξ (gamS_cx ξ))
Γᴿ ∶ ℝ → ℝ   ⍝ gamma function of a lazy argument (through the diagonal; converges away from the poles)
Γᴿ ∶ ℝ[i] → ℝ[i]
Γᴿ ≔ (⟐ Γ)
lgamma ∶ ℚ → ℝ   ⍝ log|Γ(x)| of a real x (as C's lgamma): Stirling's series after a shift; 0 at the poles; element n within 2⁻ⁿ
lgamma ξ ≔ ((npi_cx ξ) (⁂ 0) (mkq_cx (lgq_cx ξ)))
digamma ∶ ℚ → ℝ   ⍝ digamma function ψ(z) = Γ′(z)/Γ(z): asymptotic series after the shift ψ(z) = ψ(z + N) − Σ 1/(z + j); 0 at the poles; element n within 2⁻ⁿ
digamma ∶ ℚ[i] → ℝ[i]
digamma ξ ≔ ((npi_cx ξ) (⁂ 0) (rel_cx ξ (mkq_cx (dgq_cx ξ))))
beta ∶ ℚ → ℚ → ℝ   ⍝ beta function B(a, b) = Γ(a)Γ(b)/Γ(a + b) = e^(log Γ(a) + log Γ(b) − log Γ(a + b)) (one exponential); 0 when a or b is a pole of Γ, and when a + b is one (1/Γ(a + b) = 0); element n within 2⁻ⁿ
beta ∶ ℚ[i] → ℚ[i] → ℝ[i]
beta ξ η ≔ ((∨ (∨ (npi_cx ξ) (npi_cx η)) (npi_cx (⊞ ξ η))) (⁂ 0) ((θ ↦ ((∧ (isreal_cx ξ) (isreal_cx η)) (⫶ ℜ θ) θ)) (mkq_cx (btq_cx ξ η))))
erf ∶ ℚ → ℝ   ⍝ error function erf z = (2/√π)·Σ (−1)ᵏ z^(2k+1)/(k!(2k + 1)) (all terms carried at the precision the largest one needs); for real |x| ≥ 1 with x² ≥ 0.7n element n is ±1 (erfc|x| < e^(−x²)); element n within 2⁻ⁿ; the cost grows with |z|²
erf ∶ ℚ[i] → ℝ[i]
erf ξ ≔ ((θ ↦ ((isreal_cx ξ) (mk_cx (μ ↦ ((∧ (⩾ (abs (ℜ ξ)) 1) (⩾ (⊠ (ℜ ξ) (ℜ ξ)) (⊠ (÷ 111011101 111001100) μ))) ((⩾ (ℜ ξ) 0) 1 11101) (ℜ (at_cx θ μ))))) θ)) (erfS_cx ξ))
erfᴿ ∶ ℝ → ℝ   ⍝ error function of a lazy argument
erfᴿ ∶ ℝ[i] → ℝ[i]
erfᴿ ≔ (⟐ erf)
erfc ∶ ℚ → ℝ   ⍝ complementary error function 1 − erf z (absolute error: element n within 2⁻ⁿ)
erfc ∶ ℚ[i] → ℝ[i]
erfc ξ ≔ ((θ ↦ (mk_cx (μ ↦ (⊟ 1 (at_cx θ μ))))) (erf ξ))
erfcᴿ ∶ ℝ → ℝ   ⍝ complementary error function of a lazy argument
erfcᴿ ∶ ℝ[i] → ℝ[i]
erfcᴿ ≔ (⟐ erfc)
zeta ∶ ℚ → ℝ   ⍝ Riemann zeta function ζ(s): Euler–Maclaurin summation (Re s ≥ −8; exact powers for an integer s), the functional equation below; exact at 0 and the negative integers (−B₍ₙ₊₁₎/(n + 1)); ζ(1) = 0 (pole); element n within 2⁻ⁿ; the cost grows with |s|
zeta ∶ ℚ[i] → ℝ[i]
zeta ξ ≔ (rel_cx ξ (zetaS_cx ξ))
polylog ∶ ℤ → ℚ[i] → ℝ[i]   ⍝ polylogarithm Liₛ(z) for an integer s: the rational function z·Aₜ(z)/(1 − z)^(t+1) for s = −t ≤ 0 (Eulerian polynomials, every z ≠ 1), −log(1 − z) for s = 1 (z ≠ 1), Σ zᵏ/kˢ for s ≥ 2 and |z| < 1, ζ(s) at z = 1 and −(1 − 2^(1−s))·ζ(s) at z = −1; 0 elsewhere (|z| ≥ 1) and at the pole z = 1; element n within 2⁻ⁿ
polylog ≔ plS_cx
lambertw ∶ ℚ → ℝ   ⍝ Lambert W function, principal branch: W(x)·e^W(x) = x for a real x ≥ −1/e (Newton's method with a certified residual bound); 0 for x < −1/e; element n within 2⁻ⁿ
lambertw ≔ lwS_cx
lambertwᴿ ∶ ℝ → ℝ   ⍝ Lambert W function of a lazy argument
lambertwᴿ ≔ (⟐ lambertw)
besselj ∶ ℤ → ℚ → ℝ   ⍝ Bessel function of the first kind Jₙ(z) of integer order n (power series; J₋ₙ = (−1)ⁿJₙ); element n within 2⁻ⁿ; the cost grows with |z|
besselj ∶ ℤ → ℚ[i] → ℝ[i]
besselj ν ξ ≔ (rel_cx ξ (bjS_cx ν ξ))
⍝ modified Bessel function of the first kind of integer order: Iₙ(z) = Σ (z/2)^(2k+n)/(k!(k + n)!), I₋ₙ = Iₙ;  ratio (z/2)²/(k(k + n)),
⍝ |ratio| ≤ |z|²/(4k²), products ≤ e^|z|   (the series of Jₙ without the alternating sign)
biS_cx ∶ ℤ → ℚ[i] → ℝ[i]
biS_cx ν ξ ≔ ((⩾ ν 0) ((≐ ξ 0) ((≐ ν 0) (⁂ 1) (⁂ 0)) (sEs_cx (÷ (^ (÷ ξ 1100) ν) (fact ν)) (κ ↦ (÷ (⊠ ξ ξ) (⊠ 111010000 (⊠ κ (⊞ κ ν))))) (κ ↦ (lg2_cx (÷ (𝒩 ξ) (⊠ 111010000 (⊠ κ κ))))) (bz_cx ξ))) (biS_cx (⊖ ν) ξ))
besseli ∶ ℤ → ℚ → ℝ   ⍝ modified Bessel function of the first kind Iₙ(z) of integer order n (power series; I₋ₙ = Iₙ); element n within 2⁻ⁿ; the cost grows with |z|
besseli ∶ ℤ → ℚ[i] → ℝ[i]
besseli ν ξ ≔ (rel_cx ξ (biS_cx ν ξ))
erfi ∶ ℚ → ℝ   ⍝ imaginary error function erfi z = −i·erf(iz) = (2/√π)·Σ z^(2k+1)/(k!(2k + 1)); element n within 2⁻ⁿ; the cost grows with |z|²
erfi ∶ ℚ[i] → ℝ[i]
erfi ξ ≔ (rel_cx ξ (sclR_cx 111 (erf (⊠ 11 ξ))))
agm ∶ ℚ → ℚ → ℝ   ⍝ arithmetic–geometric mean M(a, b) of reals of one sign (M(−a, −b) = −M(a, b)), with outward rounding; 0 when a·b ≤ 0; element n within 2⁻ⁿ
agm ξ η ≔ ((∨ (⩽ ξ 0) (⩽ η 0)) ((∧ (≺ ξ 0) (≺ η 0)) (negR_cx (mkq_cx (agmq_cx (⊖ ξ) (⊖ η)))) (⁂ 0)) (mkq_cx (agmq_cx ξ η)))
ellipk ∶ ℚ → ℝ   ⍝ complete elliptic integral of the first kind K(m) = ∫₀^(π/2) dθ/√(1 − m·sin²θ) (parameter m < 1) = π/(2·M(1, √(1 − m))); 0 for m ≥ 1 (pole at 1); element n within 2⁻ⁿ
ellipk ξ ≔ ((⩾ ξ 1) (⁂ 0) (mkq_cx (ekq_cx ξ)))
ellipe ∶ ℚ → ℝ   ⍝ complete elliptic integral of the second kind E(m) = ∫₀^(π/2) √(1 − m·sin²θ) dθ (m ≤ 1) = K(m)·(1 − Σ 2^(n−1)cₙ²) (Gauss' AGM method, outward rounding); E(1) = 1; 0 for m > 1; element n within 2⁻ⁿ
ellipe ξ ≔ ((≐ ξ 1) (⁂ 1) ((⩾ ξ 1) (⁂ 0) (mkq_cx (eeq_cx ξ))))
Ei ∶ ℚ → ℝ   ⍝ exponential integral Ei(x) = γ + log|x| + Σ xᵏ/(k·k!) (principal value for x > 0); 0 at x = 0 (pole); element n within 2⁻ⁿ
Ei ≔ eiS_cx
li ∶ ℚ → ℝ   ⍝ logarithmic integral li(x) = Ei(log x) for x > 0 (principal value for x > 1); 0 at x = 1 (pole) and for x ≤ 0; element n within 2⁻ⁿ
li ≔ liS_cx
Si ∶ ℚ → ℝ   ⍝ sine integral Si(z) = ∫₀ᶻ sin t/t dt (power series); element n within 2⁻ⁿ
Si ∶ ℚ[i] → ℝ[i]
Si ξ ≔ (rel_cx ξ (siS_cx ξ))
Siᴿ ∶ ℝ → ℝ   ⍝ sine integral of a lazy argument
Siᴿ ∶ ℝ[i] → ℝ[i]
Siᴿ ≔ (⟐ Si)
Ci ∶ ℚ[i] → ℝ[i]   ⍝ cosine integral Ci(z) = γ + log z + Σ (−1)ᵏ z^(2k)/(2k(2k)!) (principal log: Ci(−x) = Ci(x) + iπ for x > 0); 0 at z = 0 (pole); element n within 2⁻ⁿ
Ci ≔ ciS_cx
⍝ hyperbolic sine and cosine integrals: Shi z = Σ z^(2k+1)/((2k + 1)(2k + 1)!) (the series of Si without the alternating sign) and
⍝ Chi z = γ + log z + Σₖ≥₁ z^(2k)/(2k(2k)!) (that of Ci without it);  the same ratio bounds, |ratio| ≤ |z|²/(4k²)
shiS_cx ∶ ℚ[i] → ℝ[i]
shiS_cx ξ ≔ ((≐ ξ 0) (⁂ 0) (sEs_cx ξ (κ ↦ (÷ (⊠ (⊠ ξ ξ) (⊟ (⊠ 1100 κ) 1)) (⊠ (⊠ 1100 κ) (⊠ (⊞ (⊠ 1100 κ) 1) (⊞ (⊠ 1100 κ) 1))))) (κ ↦ (lg2_cx (÷ (𝒩 ξ) (⊠ 111010000 (⊠ κ κ))))) (bz_cx ξ)))
chiS_cx ∶ ℚ[i] → ℝ[i]
chiS_cx ξ ≔ ((≐ ξ 0) (⁂ 0) (sumR_cx (sumR_cx 𝛾 (logS_cx ξ)) (sEs_cx (÷ (⊠ ξ ξ) 111010000) (κ ↦ (÷ (⊠ (⊠ ξ ξ) (⊠ 1100 κ)) (⊠ (⊠ (⊞ (⊠ 1100 κ) 1100) (⊞ (⊠ 1100 κ) 1100)) (⊞ (⊠ 1100 κ) 1)))) (κ ↦ (lg2_cx (÷ (𝒩 ξ) (⊠ 111010000 (⊠ κ κ))))) (bz_cx ξ))))
Shi ∶ ℚ → ℝ   ⍝ hyperbolic sine integral Shi(z) = ∫₀ᶻ sinh t/t dt (power series); element n within 2⁻ⁿ; the cost grows with |z|
Shi ∶ ℚ[i] → ℝ[i]
Shi ξ ≔ (rel_cx ξ (shiS_cx ξ))
Chi ∶ ℚ[i] → ℝ[i]   ⍝ hyperbolic cosine integral Chi(z) = γ + log z + Σ z^(2k)/(2k(2k)!) (principal log); 0 at z = 0 (pole); element n within 2⁻ⁿ
Chi ≔ chiS_cx
⍝ Dawson's integral D(z) = e^(−z²)∫₀ᶻ e^(t²) dt = Σ (−2z²)ᵏ z/(3·5⋯(2k + 1)):  ratio −2z²/(2k + 1), |ratio| ≤ |z|²/k, products ≤ e^|z|²
daS_cx ∶ ℚ[i] → ℝ[i]
daS_cx ξ ≔ ((≐ ξ 0) (⁂ 0) (sEs_cx ξ (κ ↦ (÷ (⊠ 11101 (⊠ 1100 (⊠ ξ ξ))) (⊞ (⊠ 1100 κ) 1))) (κ ↦ (lg2_cx (÷ (𝒩 ξ) κ))) (⊞ (⌈ (𝒩 ξ)) 1)))
dawson ∶ ℚ → ℝ   ⍝ Dawson's integral D(z) = e^(−z²)·∫₀ᶻ e^(t²) dt = (√π/2)·e^(−z²)·erfi(z) (power series); element n within 2⁻ⁿ; the cost grows with |z|²
dawson ∶ ℚ[i] → ℝ[i]
dawson ξ ≔ (rel_cx ξ (daS_cx ξ))
