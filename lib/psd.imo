⍝ lib/psd.imo — spec notation — trusted prelude — generated by libsrc/build.sh from libsrc/psd.hum.imo: edit that file, not this one
⍝ psd.hum.imo -- the sign of a quadratic polynomial, exactly (human notation; lib/psd.imo is its translation, made by libsrc/build.sh).
⍝ A polynomial of lib/polynf.imo is a list of terms (coefficient, monomial); a monomial is a list of (atom, exponent).  A polynomial of degree 2 is (x, 1) M (x, 1)^T for a symmetric matrix M of rationals
⍝ (x the atoms, the last coordinate the constant): it is non-negative for all values exactly when M is positive semidefinite.  The elimination below (LDL^T with exact rationals) decides that, and gives
⍝ the minimum s of the polynomial when it is bounded below: then p >= s everywhere and p = s somewhere, so p >= 0 iff s >= 0 and p > 0 iff s > 0.
⍝ quadsign p is 3 if p > 0 for all values, 2 if p >= 0 (and 0 somewhere), 0 if p < 0 for all, 1 if p <= 0 (and 0 somewhere), 4 when this analysis cannot tell (or p is not of degree 2).
⍝ the first row and column are eliminated: a positive pivot changes the rest by the Schur complement, a zero pivot needs a zero row (and is dropped), a negative pivot means not semidefinite
⍝ the cell (i, j) of M that the term c.m contributes to; n is the index of the constant coordinate
psdsum′ ∶ (→ (𝔏 ℚ) ℚ)
psdsum′ xs ≔ (foldl (a ∶ ℚ ↦ (b ∶ ℚ ↦ (⊞ a b))) 0 xs)
psdrowzero′ ∶ (→ (𝔏 ℚ) 𝔹)
psdrowzero′ r ≔ (∀ₗ (x ∶ ℚ ↦ (≐ x 0)) r)
psd′ ∶ (→ (𝔏 (𝔏 ℚ)) (𝔏 ℚ))
psd′ m ≔ (⁇ (≐ (ℓ m) 1) (∷ (hd (hd m)) ⊘) (⁇ (≺ (hd (hd m)) 0) ⊘ (⁇ (≐ (hd (hd m)) 0) (⁇ (psdrowzero′ (hd m)) (psd′ (⫶ ⌄ (⌄ m))) ⊘) (psd′ (⫶ (r ∶ (𝔏 ℚ) ↦ (zipwith (a ∶ ℚ ↦ (b ∶ ℚ ↦ (⊟ a (÷ (⊠ (hd r) b) (hd (hd m)))))) (⌄ r) (⌄ (hd m)))) (⌄ m))))))
psdneg′ ∶ (→ (𝔏 (𝔏 ℚ)) (𝔏 (𝔏 ℚ)))
psdneg′ m ≔ (⫶ (r ∶ (𝔏 ℚ) ↦ (⫶ (x ∶ ℚ ↦ (⊟ 0 x)) r)) m)
psdclass′ ∶ (→ (𝔏 ℚ) (→ (𝔏 ℚ) ℕ))
psdclass′ a b ≔ (⁇ (∧ (¬ (∅ a)) (≻ (hd a) 0)) 1101 (⁇ (∧ (¬ (∅ a)) (≐ (hd a) 0)) 1100 (⁇ (∧ (¬ (∅ b)) (≻ (hd b) 0)) 0 (⁇ (∧ (¬ (∅ b)) (≐ (hd b) 0)) 1 111010000))))
psdatoms′ ∶ (→ (𝔏 (𝔓 ℚ[i] (𝔏 (𝔓 Term ℕ)))) (𝔏 Term))
psdatoms′ p ≔ (nubby teq (concatmap (t ∶ (𝔓 ℚ[i] (𝔏 (𝔓 Term ℕ))) ↦ (⫶ ◀ (▶ t))) p))
psdpos′ ∶ (→ Term (→ (𝔏 Term) ℕ))
psdpos′ a atoms ≔ (⁇ (teq a (hd atoms)) 0 (⊞ 1 (psdpos′ a (⌄ atoms))))
psddeg′ ∶ (→ (𝔏 (𝔓 Term ℕ)) ℕ)
psddeg′ m ≔ (sumof (⫶ ▶ m))
psdokmono′ ∶ (→ (𝔏 (𝔓 Term ℕ)) 𝔹)
psdokmono′ m ≔ (∨ (∅ m) (∨ (∧ (≐ (ℓ m) 1) (⩽ (▶ (hd m)) 1100)) (∧ (≐ (ℓ m) 1100) (∧ (≐ (▶ (hd m)) 1) (≐ (▶ (hd (⌄ m))) 1)))))
psdapplicable′ ∶ (→ (𝔏 (𝔓 ℚ[i] (𝔏 (𝔓 Term ℕ)))) 𝔹)
psdapplicable′ p ≔ (∧ (∀ₗ (t ∶ (𝔓 ℚ[i] (𝔏 (𝔓 Term ℕ))) ↦ (∧ (≐ (ℑ (◀ t)) 0) (psdokmono′ (▶ t)))) p) (∃ₗ (t ∶ (𝔓 ℚ[i] (𝔏 (𝔓 Term ℕ))) ↦ (≐ (psddeg′ (▶ t)) 1100)) p))
psdcell′ ∶ (→ (𝔏 Term) (→ ℕ (→ ℚ (→ (𝔏 (𝔓 Term ℕ)) (→ ℕ (→ ℕ ℚ))))))
psdcell′ atoms n c m i j ≔ (⁇ (∅ m) (⁇ (∧ (≐ i n) (≐ j n)) c 0) (⁇ (≐ (ℓ m) 1) (⁇ (≐ (▶ (hd m)) 1100) (⁇ (∧ (≐ i (psdpos′ (◀ (hd m)) atoms)) (≐ j i)) c 0) (⁇ (∨ (∧ (≐ i (psdpos′ (◀ (hd m)) atoms)) (≐ j n)) (∧ (≐ j (psdpos′ (◀ (hd m)) atoms)) (≐ i n))) (÷ c 1100) 0)) (⁇ (∨ (∧ (≐ i (psdpos′ (◀ (hd m)) atoms)) (≐ j (psdpos′ (◀ (hd (⌄ m))) atoms))) (∧ (≐ j (psdpos′ (◀ (hd m)) atoms)) (≐ i (psdpos′ (◀ (hd (⌄ m))) atoms)))) (÷ c 1100) 0)))
psdmat′ ∶ (→ (𝔏 (𝔓 ℚ[i] (𝔏 (𝔓 Term ℕ)))) (→ (𝔏 Term) (𝔏 (𝔏 ℚ))))
psdmat′ p atoms ≔ (⫶ (i ∶ ℕ ↦ (⫶ (j ∶ ℕ ↦ (psdsum′ (⫶ (t ∶ (𝔓 ℚ[i] (𝔏 (𝔓 Term ℕ))) ↦ (psdcell′ atoms (ℓ atoms) (ℜ (◀ t)) (▶ t) i j)) p))) (upto 0 (ℓ atoms)))) (upto 0 (ℓ atoms)))
psdsign′ ∶ (→ (𝔏 (𝔏 ℚ)) ℕ)
psdsign′ m ≔ (psdclass′ (psd′ m) (psd′ (psdneg′ m)))
quadsign ∶ (→ (𝔏 (𝔓 ℚ[i] (𝔏 (𝔓 Term ℕ)))) ℕ)
quadsign p ≔ (⁇ (psdapplicable′ p) (psdsign′ (psdmat′ p (psdatoms′ p))) 111010000)
