⍝ lib/regex.imo — spec notation — trusted prelude — generated by libsrc/build.sh from libsrc/regex.hum.imo: edit that file, not this one
⍝ regex.hum.imo -- regular expressions by Brzozowski derivatives (human notation; lib/regex.imo is its translation, made by libsrc/build.sh).
⍝ A regular expression is a Term (lib/term.imo): the symbol 1 is the empty set, 2 the empty string, 3 c a character, 5 the concatenation, 6 the union, 7 the star, 8 a class of characters
⍝ (the number 0 or 1 for negation, then ranges: the symbol 9 applied to the first and the last character).  rxparse reads the usual notation: | * + ? ( ) . [a-z] [^a-z] and the escapes
⍝ \d \w \s \D \W \S \n \t, any other character after a backslash standing for itself.  A match is the longest one at the leftmost position (the language decides, not an order of trying).
⍝ the parser: each function returns the term read and the rest of the string
⍝ the items of a class up to the closing bracket: single characters, ranges a-z and the escapes \d \w \s
⍝ matching strings
⍝ the length of the longest prefix of s that the expression matches, as a list of at most one number
⍝ the leftmost longest match: a list of at most one pair(start, length)
⍝ the non-empty matches, left to right, without overlap
⍝ replace every non-empty match by a literal string
⍝ split at the non-empty matches (the pieces between them, empty ones included)
rxlparen′ ∶ 𝕮
rxlparen′ ≔ (chr 110111000000)
rxrparen′ ∶ 𝕮
rxrparen′ ≔ (chr 110111000001)
rxlbrack′ ∶ 𝕮
rxlbrack′ ≔ (chr 11101110011001101)
rxrbrack′ ∶ 𝕮
rxrbrack′ ≔ (chr 11101110000010001)
rxl′ ∶ (→ α (→ (→ α β) β))
rxl′ x f ≔ (f x)
rxempty ∶ Term
rxempty ≔ (tconst 1)
rxeps ∶ Term
rxeps ≔ (tconst 1100)
rxchar ∶ (→ 𝕮 Term)
rxchar c ≔ (tapp 1101 (∷ (tnum c) ⊘))
rxrange ∶ (→ 𝕮 (→ 𝕮 Term))
rxrange lo hi ≔ (tapp 111000001 (∷ (tnum lo) (∷ (tnum hi) ⊘)))
rxclass ∶ (→ ℕ (→ (𝔏 Term) Term))
rxclass neg rs ≔ (tapp 111000000 (∷ (tnum neg) rs))
rxany ∶ Term
rxany ≔ (rxclass 1 (∷ (rxrange '\n' '\n') ⊘))
rxcat ∶ (→ Term (→ Term Term))
rxcat a b ≔ (⁇ (∨ (tisconst 1 a) (tisconst 1 b)) rxempty (⁇ (tisconst 1100 a) b (⁇ (tisconst 1100 b) a (tapp 111010001 (∷ a (∷ b ⊘))))))
rxalt ∶ (→ Term (→ Term Term))
rxalt a b ≔ (⁇ (tisconst 1 a) b (⁇ (tisconst 1 b) a (⁇ (teq a b) a (tapp 111011100 (∷ a (∷ b ⊘))))))
rxstar ∶ (→ Term Term)
rxstar a ≔ (⁇ (∨ (tisconst 1 a) (tisconst 1100 a)) rxeps (⁇ (tishead 111011101 a) a (tapp 111011101 (∷ a ⊘))))
rxnullable ∶ (→ Term 𝔹)
rxnullable r ≔ (⁇ (∨ (tishead 1100 r) (tishead 111011101 r)) ⊤ (⁇ (tishead 111010001 r) (∧ (rxnullable (hd (targs r))) (rxnullable (hd (⌄ (targs r))))) (⁇ (tishead 111011100 r) (∨ (rxnullable (hd (targs r))) (rxnullable (hd (⌄ (targs r))))) ⊥)))
inrange′ ∶ (→ 𝕮 (→ Term 𝔹))
inrange′ c r ≔ (∧ (⩽ (ℜ (tnumval (hd (targs r)))) c) (⩽ c (ℜ (tnumval (hd (⌄ (targs r)))))))
inclass′ ∶ (→ 𝕮 (→ Term 𝔹))
inclass′ c r ≔ (≐ (ι (∃ₗ (q ∶ Term ↦ (inrange′ c q)) (⌄ (targs r)))) (ι (≐ (ℜ (tnumval (hd (targs r)))) 0)))
rxderiv ∶ (→ 𝕮 (→ Term Term))
rxderiv c r ≔ (⁇ (tishead 1101 r) (⁇ (≐ (ℜ (tnumval (hd (targs r)))) c) rxeps rxempty) (⁇ (tishead 111000000 r) (⁇ (inclass′ c r) rxeps rxempty) (⁇ (tishead 111010001 r) (rxalt (rxcat (rxderiv c (hd (targs r))) (hd (⌄ (targs r)))) (⁇ (rxnullable (hd (targs r))) (rxderiv c (hd (⌄ (targs r)))) rxempty)) (⁇ (tishead 111011100 r) (rxalt (rxderiv c (hd (targs r))) (rxderiv c (hd (⌄ (targs r))))) (⁇ (tishead 111011101 r) (rxcat (rxderiv c (hd (targs r))) r) rxempty)))))
rxderivs ∶ (→ 𝕊 (→ Term Term))
rxderivs s r ≔ (foldl (q ∶ Term ↦ (c ∶ 𝕮 ↦ (rxderiv c q))) r s)
rxmatches ∶ (→ Term (→ 𝕊 𝔹))
rxmatches r s ≔ (rxnullable (rxderivs s r))
rxsub′ ∶ (→ ℕ (→ (𝔏 Term) Term))
rxsub′ neg rs ≔ (rxclass neg rs)
rxdigits′ ∶ (𝔏 Term)
rxdigits′ ≔ (∷ (rxrange '0' '9') ⊘)
rxword′ ∶ (𝔏 Term)
rxword′ ≔ (∷ (rxrange '0' '9') (∷ (rxrange 'A' 'Z') (∷ (rxrange '_' '_') (∷ (rxrange 'a' 'z') ⊘))))
rxspace′ ∶ (𝔏 Term)
rxspace′ ≔ (∷ (rxrange ' ' ' ') (∷ (rxrange '	' (chr 100010001)) ⊘))
rxescape′ ∶ (→ 𝕮 Term)
rxescape′ c ≔ (⁇ (≐ c 'd') (rxclass 0 rxdigits′) (⁇ (≐ c 'w') (rxclass 0 rxword′) (⁇ (≐ c 's') (rxclass 0 rxspace′) (⁇ (≐ c 'D') (rxclass 1 rxdigits′) (⁇ (≐ c 'W') (rxclass 1 rxword′) (⁇ (≐ c 'S') (rxclass 1 rxspace′) (⁇ (≐ c 'n') (rxchar '\n') (⁇ (≐ c 't') (rxchar '	') (rxchar c)))))))))
rxescchar′ ∶ (→ 𝕮 𝕮)
rxescchar′ c ≔ (⁇ (≐ c 'n') '\n' (⁇ (≐ c 't') '	' c))
rxitems′ ∶ (→ 𝕊 (→ (𝔏 Term) (𝔓 (𝔏 Term) 𝕊)))
rxitems′ s acc ≔ (⁇ (∅ s) (⊗ (reverse acc) s) (⁇ (≐ (hd s) rxrbrack′) (⊗ (reverse acc) (⌄ s)) (⁇ (≐ (hd s) '\\') (⁇ (∅ (⌄ s)) (⊗ (reverse acc) (⌄ s)) (⁇ (≐ (hd (⌄ s)) 'd') (rxitems′ (⌄ (⌄ s)) (⧺ (reverse rxdigits′) acc)) (⁇ (≐ (hd (⌄ s)) 'w') (rxitems′ (⌄ (⌄ s)) (⧺ (reverse rxword′) acc)) (⁇ (≐ (hd (⌄ s)) 's') (rxitems′ (⌄ (⌄ s)) (⧺ (reverse rxspace′) acc)) (rxitems′ (⌄ (⌄ s)) (∷ (rxrange (rxescchar′ (hd (⌄ s))) (rxescchar′ (hd (⌄ s)))) acc)))))) (⁇ (∧ (⩾ (ℓ s) 1101) (∧ (≐ (hd (⌄ s)) '-') (¬ (≐ (hd (⌄ (⌄ s))) rxrbrack′)))) (rxitems′ (drop 1101 s) (∷ (rxrange (hd s) (hd (⌄ (⌄ s)))) acc)) (rxitems′ (⌄ s) (∷ (rxrange (hd s) (hd s)) acc))))))
rxclassp′ ∶ (→ 𝕊 (𝔓 Term 𝕊))
rxclassp′ s ≔ (⁇ (∧ (¬ (∅ s)) (≐ (hd s) '^')) (rxl′ (rxitems′ (⌄ s) ⊘) (r ∶ (𝔓 (𝔏 Term) 𝕊) ↦ (⊗ (rxclass 1 (◀ r)) (▶ r)))) (rxl′ (rxitems′ s ⊘) (r ∶ (𝔓 (𝔏 Term) 𝕊) ↦ (⊗ (rxclass 0 (◀ r)) (▶ r)))))
rxatom′ ∶ (→ (→ 𝕊 (𝔓 Term 𝕊)) (→ 𝕊 (𝔓 Term 𝕊)))
rxatom′ palt s ≔ (⁇ (≐ (hd s) rxlparen′) (rxl′ (palt (⌄ s)) (r ∶ (𝔓 Term 𝕊) ↦ (⊗ (◀ r) (⁇ (∅ (▶ r)) (▶ r) (⌄ (▶ r)))))) (⁇ (≐ (hd s) rxlbrack′) (rxclassp′ (⌄ s)) (⁇ (≐ (hd s) '.') (⊗ rxany (⌄ s)) (⁇ (∧ (≐ (hd s) '\\') (¬ (∅ (⌄ s)))) (⊗ (rxescape′ (hd (⌄ s))) (⌄ (⌄ s))) (⊗ (rxchar (hd s)) (⌄ s))))))
rxsuffix′ ∶ (→ Term (→ 𝕊 (𝔓 Term 𝕊)))
rxsuffix′ a s ≔ (⁇ (∅ s) (⊗ a s) (⁇ (≐ (hd s) '*') (rxsuffix′ (rxstar a) (⌄ s)) (⁇ (≐ (hd s) '+') (rxsuffix′ (rxcat a (rxstar a)) (⌄ s)) (⁇ (≐ (hd s) '?') (rxsuffix′ (rxalt a rxeps) (⌄ s)) (⊗ a s)))))
rxrep′ ∶ (→ (→ 𝕊 (𝔓 Term 𝕊)) (→ 𝕊 (𝔓 Term 𝕊)))
rxrep′ palt s ≔ (rxl′ (rxatom′ palt s) (r ∶ (𝔓 Term 𝕊) ↦ (rxsuffix′ (◀ r) (▶ r))))
rxcat′ ∶ (→ (→ 𝕊 (𝔓 Term 𝕊)) (→ 𝕊 (𝔓 Term 𝕊)))
rxcat′ palt s ≔ (⁇ (∨ (∅ s) (∨ (≐ (hd s) '|') (≐ (hd s) rxrparen′))) (⊗ rxeps s) (rxl′ (rxrep′ palt s) (r ∶ (𝔓 Term 𝕊) ↦ (rxl′ (rxcat′ palt (▶ r)) (q ∶ (𝔓 Term 𝕊) ↦ (⊗ (rxcat (◀ r) (◀ q)) (▶ q)))))))
rxalt′ ∶ (→ 𝕊 (𝔓 Term 𝕊))
rxalt′ s ≔ (rxl′ (rxcat′ rxalt′ s) (r ∶ (𝔓 Term 𝕊) ↦ (⁇ (∧ (¬ (∅ (▶ r))) (≐ (hd (▶ r)) '|')) (rxl′ (rxalt′ (⌄ (▶ r))) (q ∶ (𝔓 Term 𝕊) ↦ (⊗ (rxalt (◀ r) (◀ q)) (▶ q)))) r)))
rxparse ∶ (→ 𝕊 Term)
rxparse s ≔ (rxl′ (rxalt′ s) (r ∶ (𝔓 Term 𝕊) ↦ (⁇ (∅ (▶ r)) (◀ r) rxempty)))
rxfull ∶ (→ 𝕊 (→ 𝕊 𝔹))
rxfull pattern s ≔ (rxmatches (rxparse pattern) s)
rxlongest′ ∶ (→ Term (→ 𝕊 (→ ℕ (→ (𝔏 ℕ) (𝔏 ℕ)))))
rxlongest′ r s k best ≔ (rxl′ (⁇ (rxnullable r) (∷ k ⊘) best) (b ∶ (𝔏 ℕ) ↦ (⁇ (∨ (∅ s) (tishead 1 r)) b (rxlongest′ (rxderiv (hd s) r) (⌄ s) (⊞ k 1) b))))
rxprefix ∶ (→ 𝕊 (→ 𝕊 (𝔏 ℕ)))
rxprefix pattern s ≔ (rxlongest′ (rxparse pattern) s 0 ⊘)
rxsearchgo′ ∶ (→ Term (→ 𝕊 (→ ℕ (𝔏 (𝔓 ℕ ℕ)))))
rxsearchgo′ r s i ≔ (⁇ (∅ (rxlongest′ r s 0 ⊘)) (⁇ (∅ s) ⊘ (rxsearchgo′ r (⌄ s) (⊞ i 1))) (∷ (⊗ i (hd (rxlongest′ r s 0 ⊘))) ⊘))
rxsearch ∶ (→ 𝕊 (→ 𝕊 (𝔏 (𝔓 ℕ ℕ))))
rxsearch pattern s ≔ (rxsearchgo′ (rxparse pattern) s 0)
rxfindgo′ ∶ (→ Term (→ 𝕊 (𝔏 𝕊)))
rxfindgo′ r s ≔ (⁇ (∅ s) ⊘ (⁇ (∨ (∅ (rxlongest′ r s 0 ⊘)) (≐ (hd (rxlongest′ r s 0 ⊘)) 0)) (rxfindgo′ r (⌄ s)) (∷ (take (hd (rxlongest′ r s 0 ⊘)) s) (rxfindgo′ r (drop (hd (rxlongest′ r s 0 ⊘)) s)))))
rxfindall ∶ (→ 𝕊 (→ 𝕊 (𝔏 𝕊)))
rxfindall pattern s ≔ (rxfindgo′ (rxparse pattern) s)
rxreplacego′ ∶ (→ Term (→ 𝕊 (→ 𝕊 𝕊)))
rxreplacego′ r t s ≔ (⁇ (∅ s) ⊘ (⁇ (∨ (∅ (rxlongest′ r s 0 ⊘)) (≐ (hd (rxlongest′ r s 0 ⊘)) 0)) (∷ (hd s) (rxreplacego′ r t (⌄ s))) (⧺ t (rxreplacego′ r t (drop (hd (rxlongest′ r s 0 ⊘)) s)))))
rxreplace ∶ (→ 𝕊 (→ 𝕊 (→ 𝕊 𝕊)))
rxreplace pattern t s ≔ (rxreplacego′ (rxparse pattern) t s)
rxsplitgo′ ∶ (→ Term (→ 𝕊 (→ 𝕊 (𝔏 𝕊))))
rxsplitgo′ r s cur ≔ (⁇ (∅ s) (∷ (reverse cur) ⊘) (⁇ (∨ (∅ (rxlongest′ r s 0 ⊘)) (≐ (hd (rxlongest′ r s 0 ⊘)) 0)) (rxsplitgo′ r (⌄ s) (∷ (hd s) cur)) (∷ (reverse cur) (rxsplitgo′ r (drop (hd (rxlongest′ r s 0 ⊘)) s) ⊘))))
rxsplit ∶ (→ 𝕊 (→ 𝕊 (𝔏 𝕊)))
rxsplit pattern s ≔ (rxsplitgo′ (rxparse pattern) s ⊘)
