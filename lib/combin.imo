⍝ lib/combin.imo — spec notation — trusted prelude — generated by libsrc/build.sh from libsrc/combin.hum.imo: edit that file, not this one
⍝ combin.hum.imo -- enumerative combinatorics: triangles of numbers, lists of combinatorial objects, permutations as numbers (human notation; lib/combin.imo is its translation, made by libsrc/build.sh).
⍝ It adds to the counts of lib/numtheory.imo (choose, catalan, bell, partitions, necklaces) the objects themselves and more counts.  Permutations are lists that contain 0 to n-1 once each.
⍝ Pascal's triangle and relatives
⍝ counts
⍝ lists of objects: compositions (lexicographic), partitions (largest part first), Dyck words (U up, D down; lexicographic with D before U), Lyndon words (lexicographic)
⍝ permutations: the Lehmer code (for each place, how many later entries are smaller), the lexicographic rank, and back
⍝ all set partitions of a list, as lists of blocks: the first element is a block of its own, or joins one of the blocks of a partition of the rest
cblet′ ∶ (→ α (→ (→ α β) β))
cblet′ x f ≔ (f x)
cbadd′ ∶ (→ ℕ (→ ℕ ℕ))
cbadd′ a b ≔ (⊞ a b)
cbmul′ ∶ (→ ℕ (→ ℕ ℕ))
cbmul′ a b ≔ (⊠ a b)
cbnth′ ∶ (→ (𝔏 ℕ) (→ ℕ ℕ))
cbnth′ xs k ≔ (⁇ (≺ k (ℓ xs)) (nth xs k) 0)
cbpnext′ ∶ (→ (𝔏 ℕ) (𝔏 ℕ))
cbpnext′ row ≔ (zipwith cbadd′ (∷ 0 row) (⧺ row (∷ 0 ⊘)))
pascalrow ∶ (→ ℕ (𝔏 ℕ))
pascalrow n ≔ (applyn n cbpnext′ (∷ 1 ⊘))
cbptri′ ∶ (→ (𝔏 ℕ) (→ ℕ (𝔏 (𝔏 ℕ))))
cbptri′ row n ≔ (⁇ (≐ n 0) ⊘ (∷ row (cbptri′ (cbpnext′ row) (abs (⊟ n 1)))))
pascaltriangle ∶ (→ ℕ (𝔏 (𝔏 ℕ)))
pascaltriangle n ≔ (cbptri′ (∷ 1 ⊘) n)
multinomial ∶ (→ (𝔏 ℕ) ℕ)
multinomial ks ≔ (div (fact (sumof ks)) (foldl cbmul′ 1 (⫶ fact ks)))
multichoose ∶ (→ ℕ (→ ℕ ℕ))
multichoose n k ≔ (⁇ (≐ n 0) (⁇ (≐ k 0) 1 0) (choose (abs (⊟ (⊞ n k) 1)) k))
fallingfactorial ∶ (→ ℕ (→ ℕ ℕ))
fallingfactorial n k ≔ (⁇ (≻ k n) 0 (div (fact n) (fact (abs (⊟ n k)))))
risingfactorial ∶ (→ ℕ (→ ℕ ℕ))
risingfactorial n k ≔ (⁇ (≐ k 0) 1 (⁇ (≐ n 0) 0 (div (fact (abs (⊟ (⊞ n k) 1))) (fact (abs (⊟ n 1))))))
derangements ∶ (→ ℕ ℕ)
derangements n ≔ (⁇ (≐ n 0) 1 (abs (⊞ (⊠ n (derangements (abs (⊟ n 1)))) (⁇ (≐ (mod n 1100) 0) 1 (⊟ 0 1)))))
rencontres ∶ (→ ℕ (→ ℕ ℕ))
rencontres n k ≔ (⁇ (≻ k n) 0 (⊠ (choose n k) (derangements (abs (⊟ n k)))))
cbeunext′ ∶ (→ ℕ (→ (𝔏 ℕ) (𝔏 ℕ)))
cbeunext′ m row ≔ (⫶ (k ∶ ℕ ↦ (⊞ (⊠ (⊞ k 1) (cbnth′ row k)) (⊠ (abs (⊟ m k)) (⁇ (≐ k 0) 0 (cbnth′ row (abs (⊟ k 1))))))) (upto 0 (abs (⊟ m 1))))
cbeuiter′ ∶ (→ ℕ (→ ℕ (→ (𝔏 ℕ) (𝔏 ℕ))))
cbeuiter′ m n row ≔ (⁇ (≻ m n) row (cbeuiter′ (⊞ m 1) n (cbeunext′ m row)))
eulerianrow ∶ (→ ℕ (𝔏 ℕ))
eulerianrow n ≔ (cbeuiter′ 1 n (∷ 1 ⊘))
eulerian ∶ (→ ℕ (→ ℕ ℕ))
eulerian n k ≔ (cbnth′ (eulerianrow n) k)
narayana ∶ (→ ℕ (→ ℕ ℕ))
narayana n k ≔ (⁇ (∨ (≐ k 0) (≻ k n)) 0 (div (⊠ (choose n k) (choose n (abs (⊟ k 1)))) n))
motzkin ∶ (→ ℕ ℕ)
motzkin n ≔ (sumof (⫶ (k ∶ ℕ ↦ (⊠ (choose n (⊠ 1100 k)) (catalan k))) (upto 0 (div n 1100))))
schroeder ∶ (→ ℕ ℕ)
schroeder n ≔ (sumof (⫶ (k ∶ ℕ ↦ (div (⊠ (choose n k) (choose (⊞ n k) k)) (⊞ k 1))) (upto 0 n)))
compositions ∶ (→ ℕ (𝔏 (𝔏 ℕ)))
compositions n ≔ (⁇ (≐ n 0) (∷ ⊘ ⊘) (concatmap (k ∶ ℕ ↦ (⫶ (c ∶ (𝔏 ℕ) ↦ (∷ k c)) (compositions (abs (⊟ n k))))) (upto 1 n)))
cbplist′ ∶ (→ ℕ (→ ℕ (𝔏 (𝔏 ℕ))))
cbplist′ n m ≔ (⁇ (≐ n 0) (∷ ⊘ ⊘) (concatmap (k ∶ ℕ ↦ (⫶ (c ∶ (𝔏 ℕ) ↦ (∷ k c)) (cbplist′ (abs (⊟ n k)) k))) (reverse (upto 1 (⁇ (≺ n m) n m)))))
partitionlist ∶ (→ ℕ (𝔏 (𝔏 ℕ)))
partitionlist n ≔ (cbplist′ n n)
cbdy′ ∶ (→ ℕ (→ ℕ (𝔏 𝕊)))
cbdy′ u h ≔ (⁇ (∧ (≐ u 0) (≐ h 0)) (∷ "" ⊘) (⧺ (⁇ (≻ h 0) (⫶ (w ∶ 𝕊 ↦ (⧺ "D" w)) (cbdy′ u (abs (⊟ h 1)))) ⊘) (⁇ (≻ u 0) (⫶ (w ∶ 𝕊 ↦ (⧺ "U" w)) (cbdy′ (abs (⊟ u 1)) (⊞ h 1))) ⊘)))
dyckpaths ∶ (→ ℕ (𝔏 𝕊))
dyckpaths n ≔ (cbdy′ n 0)
cbcycle′ ∶ (→ (𝔏 ℕ) (→ ℕ (𝔏 ℕ)))
cbcycle′ w n ≔ (⫶ (i ∶ ℕ ↦ (nth w (mod i (ℓ w)))) (upto 0 (abs (⊟ n 1))))
cbstrip′ ∶ (→ (𝔏 ℕ) (→ ℕ (𝔏 ℕ)))
cbstrip′ w k ≔ (⁇ (∅ w) ⊘ (⁇ (≐ (last w) (abs (⊟ k 1))) (cbstrip′ (init w) k) w))
cblyn′ ∶ (→ (𝔏 ℕ) (→ ℕ (→ ℕ (𝔏 (𝔏 ℕ)))))
cblyn′ w n k ≔ (⧺ (⁇ (≐ (ℓ w) n) (∷ w ⊘) ⊘) (cblet′ (cbstrip′ (cbcycle′ w n) k) (v ∶ (𝔏 ℕ) ↦ (⁇ (∅ v) ⊘ (cblyn′ (⧺ (init v) (∷ (⊞ (last v) 1) ⊘)) n k)))))
lyndonwords ∶ (→ ℕ (→ ℕ (𝔏 (𝔏 ℕ))))
lyndonwords n k ≔ (⁇ (∨ (≐ n 0) (≐ k 0)) ⊘ (cblyn′ (∷ 0 ⊘) n k))
lehmer ∶ (→ (𝔏 ℕ) (𝔏 ℕ))
lehmer p ≔ (⁇ (∅ p) ⊘ (∷ (ℓ (filter (x ∶ ℕ ↦ (≺ x (hd p))) (⌄ p))) (lehmer (⌄ p))))
cbrm′ ∶ (→ ℕ (→ (𝔏 ℕ) (𝔏 ℕ)))
cbrm′ i xs ≔ (⧺ (take i xs) (drop (⊞ i 1) xs))
cbunleh′ ∶ (→ (𝔏 ℕ) (→ (𝔏 ℕ) (𝔏 ℕ)))
cbunleh′ code avail ≔ (⁇ (∅ code) ⊘ (∷ (nth avail (hd code)) (cbunleh′ (⌄ code) (cbrm′ (hd code) avail))))
unlehmer ∶ (→ (𝔏 ℕ) (𝔏 ℕ))
unlehmer code ≔ (cbunleh′ code (upto 0 (abs (⊟ (ℓ code) 1))))
cbrank′ ∶ (→ (𝔏 ℕ) ℕ)
cbrank′ code ≔ (⁇ (∅ code) 0 (⊞ (⊠ (hd code) (fact (abs (⊟ (ℓ code) 1)))) (cbrank′ (⌄ code))))
permrank ∶ (→ (𝔏 ℕ) ℕ)
permrank p ≔ (cbrank′ (lehmer p))
cbfd′ ∶ (→ ℕ (→ ℕ (𝔏 ℕ)))
cbfd′ m r ≔ (⁇ (≐ m 0) ⊘ (cblet′ (fact (abs (⊟ m 1))) (f ∶ ℕ ↦ (∷ (div r f) (cbfd′ (abs (⊟ m 1)) (mod r f))))))
permunrank ∶ (→ ℕ (→ ℕ (𝔏 (𝔏 ℕ))))
permunrank n r ≔ (⁇ (≺ r (fact n)) (∷ (unlehmer (cbfd′ n r)) ⊘) ⊘)
nextperm ∶ (→ (𝔏 ℕ) (𝔏 (𝔏 ℕ)))
nextperm p ≔ (cblet′ (⊞ (permrank p) 1) (r ∶ ℕ ↦ (permunrank (ℓ p) r)))
inversions ∶ (→ (𝔏 ℕ) ℕ)
inversions p ≔ (sumof (lehmer p))
descents ∶ (→ (𝔏 ℕ) ℕ)
descents p ≔ (⁇ (∅ p) 0 (sumof (zipwith (a ∶ ℕ ↦ (b ∶ ℕ ↦ (⁇ (≻ a b) 1 0))) p (⌄ p))))
permsign ∶ (→ (𝔏 ℕ) ℤ)
permsign p ≔ (⁇ (≐ (mod (inversions p) 1100) 0) 1 (⊟ 0 1))
cbins′ ∶ (→ α (→ (𝔏 (𝔏 α)) (→ ℕ (𝔏 (𝔏 α)))))
cbins′ x q i ≔ (⧺ (take i q) (⧺ (∷ (∷ x (nth q i)) ⊘) (drop (⊞ i 1) q)))
cbwith′ ∶ (→ α (→ (𝔏 (𝔏 α)) (𝔏 (𝔏 (𝔏 α)))))
cbwith′ x q ≔ (∷ (∷ (∷ x ⊘) q) (⫶ (i ∶ ℕ ↦ (cbins′ x q i)) (⁇ (∅ q) ⊘ (upto 0 (abs (⊟ (ℓ q) 1))))))
setpartitions ∶ (→ (𝔏 α) (𝔏 (𝔏 (𝔏 α))))
setpartitions xs ≔ (⁇ (∅ xs) (∷ ⊘ ⊘) (concatmap (q ∶ (𝔏 (𝔏 α)) ↦ (cbwith′ (hd xs) q)) (setpartitions (⌄ xs))))
