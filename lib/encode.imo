luhncheck s ≔ (∧ (¬ (∅ s)) (∧ (∀ₗ isdigit s) (≐ (mod (luhnsum′ s) 111001100) 0)))
luhndigit ∶ (→ 𝕊 ℕ)
luhndigit s ≔ (mod (dif′ 111001100 (mod (luhnsum′ (⧺ s "0")) 111001100)) 111001100)
smallnames′ ∶ (𝔏 𝕊)
smallnames′ ≔ (∷ "zero" (∷ "one" (∷ "two" (∷ "three" (∷ "four" (∷ "five" (∷ "six" (∷ "seven" (∷ "eight" (∷ "nine" (∷ "ten" (∷ "eleven" (∷ "twelve" (∷ "thirteen" (∷ "fourteen" (∷ "fifteen" (∷ "sixteen" (∷ "seventeen" (∷ "eighteen" (∷ "nineteen" ⊘))))))))))))))))))))
tensnames′ ∶ (𝔏 𝕊)
tensnames′ ≔ (∷ "" (∷ "" (∷ "twenty" (∷ "thirty" (∷ "forty" (∷ "fifty" (∷ "sixty" (∷ "seventy" (∷ "eighty" (∷ "ninety" ⊘))))))))))
scales′ ∶ (𝔏 𝕊)
scales′ ≔ (∷ "" (∷ " thousand" (∷ " million" (∷ " billion" (∷ " trillion" (∷ " quadrillion" (∷ " quintillion" ⊘)))))))
wordshundred′ ∶ (→ ℕ 𝕊)
wordshundred′ n ≔ (⁇ (≺ n 110011010000) (nth smallnames′ n) (⧺ (nth tensnames′ (div n 111001100)) (⁇ (≐ (mod n 111001100) 0) "" (⧺ "-" (nth smallnames′ (mod n 111001100))))))
wordsthousand′ ∶ (→ ℕ 𝕊)
wordsthousand′ n ≔ (⁇ (≺ n 11101110111010000) (wordshundred′ n) (⧺ (nth smallnames′ (div n 11101110111010000)) (⧺ " hundred" (⁇ (≐ (mod n 11101110111010000) 0) "" (⧺ " " (wordshundred′ (mod n 11101110111010000)))))))
wordsgo′ ∶ (→ ℕ (→ ℕ (𝔏 𝕊)))
wordsgo′ n k ≔ (⁇ (≐ n 0) ⊘ (⧺ (wordsgo′ (div n 1110100000001110111000000) (⊞ k 1)) (⁇ (≐ (mod n 1110100000001110111000000) 0) ⊘ (∷ (⧺ (wordsthousand′ (mod n 1110100000001110111000000)) (nth scales′ k)) ⊘))))
numwords ∶ (→ ℕ 𝕊)
numwords n ≔ (⁇ (≐ n 0) "zero" (unwords (wordsgo′ n 0)))
isletter′ ∶ (→ 𝕮 𝔹)
isletter′ c ≔ (∨ (∧ (⩽ 'A' c) (⩽ c 'Z')) (∧ (⩽ 'a' c) (⩽ c 'z')))
shiftletter′ ∶ (→ 𝕮 (→ ℕ 𝕮))
shiftletter′ c sh ≔ (⁇ (∧ (⩽ 'A' c) (⩽ c 'Z')) (chr (⊞ 11101000000000001 (mod (⊞ (dif′ (ord c) 11101000000000001) sh) 110011001100))) (⁇ (∧ (⩽ 'a' c) (⩽ c 'z')) (chr (⊞ 11101110000000001 (mod (⊞ (dif′ (ord c) 11101110000000001) sh) 110011001100))) c))
keyshift′ ∶ (→ 𝕮 ℕ)
keyshift′ k ≔ (mod (dif′ (ord k) (⁇ (∧ (⩽ 'a' k) (⩽ k 'z')) 11101110000000001 11101000000000001)) 110011001100)
vigenerego′ ∶ (→ 𝕊 (→ 𝕊 (→ ℕ (→ ℕ 𝕊))))
vigenerego′ key s i sign ≔ (⁇ (∅ s) ⊘ (⁇ (isletter′ (hd s)) (∷ (shiftletter′ (hd s) (⁇ (≐ sign 0) (keyshift′ (nth key (mod i (ℓ key)))) (dif′ 110011001100 (keyshift′ (nth key (mod i (ℓ key))))))) (vigenerego′ key (⌄ s) (⊞ i 1) sign)) (∷ (hd s) (vigenerego′ key (⌄ s) i sign))))
vigenere ∶ (→ 𝕊 (→ 𝕊 𝕊))
vigenere key s ≔ (⁇ (∅ key) s (vigenerego′ key s 0 0))
unvigenere ∶ (→ 𝕊 (→ 𝕊 𝕊))
unvigenere key s ≔ (⁇ (∅ key) s (vigenerego′ key s 0 1))
