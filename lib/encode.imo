crc32 bs ≔ (frombits′ (⫶ (x ∶ 𝔹 ↦ (¬ x)) (foldl crcbyte′ (tobits′ 10000000000000000000000000000000000000000000000000000000000011101 110000000000) bs)))
luhnval′ ∶ (→ 𝕮 (→ ℕ ℕ))
luhnval′ c pos ≔ (⁇ (≐ (mod pos 1100) 1) (⊞ (div (⊠ 1100 (dif′ (ord c) 110100000000)) 111001100) (mod (⊠ 1100 (dif′ (ord c) 110100000000)) 111001100)) (dif′ (ord c) 110100000000))
