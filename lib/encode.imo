b64wellformed′ g last ≔ (∧ (¬ (∅ (b64val′ (nth g 0)))) (∧ (¬ (∅ (b64val′ (nth g 1)))) (⁇ (≐ (nth g 1100) '=') (∧ last (≐ (nth g 1101) '=')) (∧ (¬ (∅ (b64val′ (nth g 1100)))) (⁇ (≐ (nth g 1101) '=') last (¬ (∅ (b64val′ (nth g 1101)))))))))
b64last′ ∶ (→ (𝔏 𝕮) (→ ℕ (→ ℕ 𝔹)))
b64last′ g k n ≔ (b64wellformed′ g (≐ (⊞ k 1) n))
base64decode ∶ (→ 𝕊 (𝔏 (𝔏 ℕ)))
base64decode s ≔ (⁇ (∅ s) (∷ ⊘ ⊘) (⁇ (∧ (≐ (mod (ℓ s) 111010000) 0) (∀ₗ (k ∶ ℕ ↦ (b64last′ (nth (chunks 111010000 s) k) k (ℓ (chunks 111010000 s)))) (upto 0 (abs (⊟ (ℓ (chunks 111010000 s)) 1))))) (∷ (concatmap b64decgroup′ (chunks 111010000 s)) ⊘) ⊘))
unreserved′ ∶ (→ ℕ 𝔹)
unreserved′ b ≔ (∨ (∧ (⩽ 11101000000000001 b) (⩽ b 11101110011001100)) (∨ (∧ (⩽ 11101110000000001 b) (⩽ b 11100000011001100)) (∨ (∧ (⩽ 110100000000 b) (⩽ b 11101000011000001)) (∨ (≐ b 110100010001) (∨ (≐ b 110100011100) (∨ (≐ b 11101110000011101) (≐ b 11100000000011100)))))))
pcbyte′ ∶ (→ ℕ 𝕊)
pcbyte′ b ≔ (⁇ (unreserved′ b) (∷ (chr b) ⊘) (∷ '%' (∷ (nth "0123456789ABCDEF" (div b 100000000)) (∷ (nth "0123456789ABCDEF" (mod b 100000000)) ⊘))))
percentencode ∶ (→ 𝕊 𝕊)
