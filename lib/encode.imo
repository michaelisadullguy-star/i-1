tobits′ n w ≔ (⁇ (≐ w 0) ⊘ (∷ (≐ (mod n 1100) 1) (tobits′ (div n 1100) (abs (⊟ w 1)))))
frombits′ ∶ (→ (𝔏 𝔹) ℕ)
frombits′ bs ≔ (⁇ (∅ bs) 0 (⊞ (⁇ (hd bs) 1 0) (⊠ 1100 (frombits′ (⌄ bs)))))
bxor′ ∶ (→ 𝔹 (→ 𝔹 𝔹))
bxor′ x y ≔ (¬ (⇔ x y))
polybits′ ∶ (𝔏 𝔹)
polybits′ ≔ (tobits′ 10001110100011100000100001100000111000000000011010000110000000000 110000000000)
crcstep′ ∶ (→ (𝔏 𝔹) (𝔏 𝔹))
crcstep′ r ≔ (⁇ (hd r) (zipwith bxor′ (⧺ (⌄ r) (∷ ⊥ ⊘)) polybits′) (⧺ (⌄ r) (∷ ⊥ ⊘)))
crcbyte′ ∶ (→ (𝔏 𝔹) (→ ℕ (𝔏 𝔹)))
crcbyte′ r b ≔ (applyn 111000000 crcstep′ (⧺ (zipwith bxor′ (take 111000000 r) (tobits′ b 111000000)) (drop 111000000 r)))
