adler32 bs ≔ (adler′ (foldl (st ∶ (𝔓 ℕ ℕ) ↦ (b ∶ ℕ ↦ (⊗ (mod (⊞ (◀ st) b) 100000000000000000001110100000001) (mod (⊞ (▶ st) (mod (⊞ (◀ st) b) 100000000000000000001110100000001)) 100000000000000000001110100000001)))) (⊗ 1 0) bs))
