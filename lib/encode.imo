utf8next′ bs ≔ (⁇ (∅ bs) ⊘ (⁇ (≺ (hd bs) 11100000000000000) (∷ (⊗ (hd bs) (⌄ bs)) ⊘) (⁇ (∧ (⩽ 10001000000000000 (hd bs)) (≺ (hd bs) 10001110000000000)) (⁇ (∧ (⩾ (ℓ bs) 1100) (∧ (iscont′ (nth bs 1)) (⩽ 11100000000000000 (cptwo′ bs)))) (∷ (⊗ (cptwo′ bs) (drop 1100 bs)) ⊘) ⊘) (⁇ (∧ (⩽ 10001110000000000 (hd bs)) (≺ (hd bs) 10001110100000000)) (⁇ (∧ (⩾ (ℓ bs) 1101) (∧ (iscont′ (nth bs 1)) (∧ (iscont′ (nth bs 1100)) (∧ (⩽ 1110000000000000000000000 (cpthree′ bs)) (¬ (∧ (⩽ 100011100110000000000000000000000 (cpthree′ bs)) (≺ (cpthree′ bs) 100011100000000000000000000000000))))))) (∷ (⊗ (cpthree′ bs) (drop 1101 bs)) ⊘) ⊘) (⁇ (∧ (⩽ 10001110100000000 (hd bs)) (≺ (hd bs) 10000000011010001)) (⁇ (∧ (⩾ (ℓ bs) 111010000) (∧ (iscont′ (nth bs 1)) (∧ (iscont′ (nth bs 1100)) (∧ (iscont′ (nth bs 1101)) (∧ (⩽ 100000000000000000000000000000000 (cpfour′ bs)) (⩽ (cpfour′ bs) 10000000100000000000000000000000000011101)))))) (∷ (⊗ (cpfour′ bs) (drop 111010000 bs)) ⊘) ⊘) ⊘)))))
utf8go′ ∶ (→ (𝔏 ℕ) (→ 𝕊 (𝔏 𝕊)))
utf8go′ bs acc ≔ (⁇ (∅ bs) (∷ (reverse acc) ⊘) (⁇ (∅ (utf8next′ bs)) ⊘ (utf8go′ (▶ (hd (utf8next′ bs))) (∷ (chr (◀ (hd (utf8next′ bs)))) acc))))
utf8string ∶ (→ (𝔏 ℕ) (𝔏 𝕊))
utf8string bs ≔ (utf8go′ bs ⊘)
hexdigit′ ∶ (→ ℕ 𝕮)
hexdigit′ d ≔ (nth "0123456789abcdef" d)
hexencode ∶ (→ (𝔏 ℕ) 𝕊)
hexencode bs ≔ (concatmap (b ∶ ℕ ↦ (∷ (hexdigit′ (div b 100000000)) (∷ (hexdigit′ (mod b 100000000)) ⊘))) bs)
hexval′ ∶ (→ 𝕮 (𝔏 ℕ))
hexval′ c ≔ (⁇ (∧ (⩽ '0' c) (⩽ c '9')) (∷ (dif′ (ord c) (ord '0')) ⊘) (⁇ (∧ (⩽ 'a' c) (⩽ c 'f')) (∷ (⊞ (dif′ (ord c) (ord 'a')) 111001100) ⊘) (⁇ (∧ (⩽ 'A' c) (⩽ c 'F')) (∷ (⊞ (dif′ (ord c) (ord 'A')) 111001100) ⊘) ⊘)))
hexdecode ∶ (→ 𝕊 (𝔏 (𝔏 ℕ)))
hexdecode s ≔ (⁇ (∨ (≐ (mod (ℓ s) 1100) 1) (∃ₗ (c ∶ 𝕮 ↦ (∅ (hexval′ c))) s)) ⊘ (∷ (⫶ (p ∶ (𝔏 𝕮) ↦ (⊞ (⊠ (hd (hexval′ (hd p))) 100000000) (hd (hexval′ (hd (⌄ p)))))) (chunks 1100 s)) ⊘))
b64char′ ∶ (→ ℕ 𝕮)
b64char′ d ≔ (nth "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" d)
b64group′ ∶ (→ (𝔏 ℕ) 𝕊)
b64group′ bs ≔ (⁇ (≐ (ℓ bs) 1) (∷ (b64char′ (div (hd bs) 111010000)) (∷ (b64char′ (⊠ (mod (hd bs) 111010000) 100000000)) (∷ '=' (∷ '=' ⊘)))) (⁇ (≐ (ℓ bs) 1100) (∷ (b64char′ (div (hd bs) 111010000)) (∷ (b64char′ (⊞ (⊠ (mod (hd bs) 111010000) 100000000) (div (nth bs 1) 100000000))) (∷ (b64char′ (⊠ (mod (nth bs 1) 100000000) 111010000)) (∷ '=' ⊘)))) (∷ (b64char′ (div (hd bs) 111010000)) (∷ (b64char′ (⊞ (⊠ (mod (hd bs) 111010000) 100000000) (div (nth bs 1) 100000000))) (∷ (b64char′ (⊞ (⊠ (mod (nth bs 1) 100000000) 111010000) (div (nth bs 1100) 11101000000000000))) (∷ (b64char′ (mod (nth bs 1100) 11101000000000000)) ⊘))))))
base64encode ∶ (→ (𝔏 ℕ) 𝕊)
base64encode bs ≔ (concatmap b64group′ (chunks 1101 bs))
b64val′ ∶ (→ 𝕮 (𝔏 ℕ))
b64val′ c ≔ (⁇ (∧ (⩽ 'A' c) (⩽ c 'Z')) (∷ (dif′ (ord c) (ord 'A')) ⊘) (⁇ (∧ (⩽ 'a' c) (⩽ c 'z')) (∷ (⊞ (dif′ (ord c) (ord 'a')) 110011001100) ⊘) (⁇ (∧ (⩽ '0' c) (⩽ c '9')) (∷ (⊞ (dif′ (ord c) (ord '0')) 11101000011010000) ⊘) (⁇ (≐ c '+') (∷ 11101000000011100 ⊘) (⁇ (≐ c '/') (∷ 11101000000011101 ⊘) ⊘)))))
b64decgroup′ ∶ (→ (𝔏 𝕮) (𝔏 ℕ))
b64decgroup′ g ≔ (⁇ (≐ (nth g 1100) '=') (∷ (⊞ (⊠ (hd (b64val′ (nth g 0))) 111010000) (div (hd (b64val′ (nth g 1))) 100000000)) ⊘) (⁇ (≐ (nth g 1101) '=') (∷ (⊞ (⊠ (hd (b64val′ (nth g 0))) 111010000) (div (hd (b64val′ (nth g 1))) 100000000)) (∷ (⊞ (⊠ (mod (hd (b64val′ (nth g 1))) 100000000) 100000000) (div (hd (b64val′ (nth g 1100))) 111010000)) ⊘)) (∷ (⊞ (⊠ (hd (b64val′ (nth g 0))) 111010000) (div (hd (b64val′ (nth g 1))) 100000000)) (∷ (⊞ (⊠ (mod (hd (b64val′ (nth g 1))) 100000000) 100000000) (div (hd (b64val′ (nth g 1100))) 111010000)) (∷ (⊞ (⊠ (mod (hd (b64val′ (nth g 1100))) 111010000) 11101000000000000) (hd (b64val′ (nth g 1101)))) ⊘)))))
