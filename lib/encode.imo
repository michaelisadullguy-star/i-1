pcgo′ ∶ (→ 𝕊 (→ (𝔏 ℕ) (𝔏 (𝔏 ℕ))))
pcgo′ s acc ≔ (⁇ (∅ s) (∷ (reverse acc) ⊘) (⁇ (≐ (hd s) '%') (⁇ (∧ (⩾ (ℓ s) 1101) (∧ (¬ (∅ (hexval′ (nth s 1)))) (¬ (∅ (hexval′ (nth s 1100)))))) (pcgo′ (drop 1101 s) (∷ (⊞ (⊠ (hd (hexval′ (nth s 1))) 100000000) (hd (hexval′ (nth s 1100)))) acc)) ⊘) (⁇ (≺ (ord (hd s)) 11100000000000000) (pcgo′ (⌄ s) (∷ (ord (hd s)) acc)) ⊘)))
