⍝ lib/geom.imo — spec notation — trusted prelude — generated by libsrc/build.sh from libsrc/geom.hum.imo: edit that file, not this one
⍝ geom.hum.imo -- plane geometry with exact rational coordinates (human notation; lib/geom.imo is its translation, made by libsrc/build.sh).
⍝ A point (or a vector) is a pair pair(x, y) of rationals, a polygon a list of points in order around it.  Nothing here needs a square root: distances are squared.
⍝ the point where the lines ab and cd meet, as a list of at most one point (empty for parallel lines)
⍝ the centre of the circle through three points, as a list of at most one point (empty for collinear points)
⍝ polygons
⍝ the position of a point with respect to a polygon: 1 inside, 0 on the boundary, minus 1 outside
⍝ the convex hull by Andrew's monotone chain: the vertices in counter-clockwise order from the lowest-leftmost point, collinear points left out
⍝ the least squared distance between two of the points (0 when there are fewer than two)
gmlet′ ∶ (→ α (→ (→ α β) β))
gmlet′ x f ≔ (f x)
ptx ∶ (→ (𝔓 ℚ ℚ) ℚ)
ptx p ≔ (◀ p)
pty ∶ (→ (𝔓 ℚ ℚ) ℚ)
pty p ≔ (▶ p)
vsub2 ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (𝔓 ℚ ℚ)))
vsub2 a b ≔ (⊗ (⊟ (◀ a) (◀ b)) (⊟ (▶ a) (▶ b)))
vadd2 ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (𝔓 ℚ ℚ)))
vadd2 a b ≔ (⊗ (⊞ (◀ a) (◀ b)) (⊞ (▶ a) (▶ b)))
vscale2 ∶ (→ ℚ (→ (𝔓 ℚ ℚ) (𝔓 ℚ ℚ)))
vscale2 k a ≔ (⊗ (⊠ k (◀ a)) (⊠ k (▶ a)))
dotp ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) ℚ))
dotp a b ≔ (⊞ (⊠ (◀ a) (◀ b)) (⊠ (▶ a) (▶ b)))
crossp ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) ℚ))
crossp a b ≔ (⊟ (⊠ (◀ a) (▶ b)) (⊠ (▶ a) (◀ b)))
dist2 ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) ℚ))
dist2 a b ≔ (dotp (vsub2 a b) (vsub2 a b))
cross3 ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) ℚ)))
cross3 o a b ≔ (crossp (vsub2 a o) (vsub2 b o))
orient ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) ℤ)))
orient a b c ≔ (sgn (cross3 a b c))
triarea2 ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) ℚ)))
triarea2 a b c ≔ (abs (cross3 a b c))
iscollinear ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) 𝔹)))
iscollinear a b c ≔ (≐ (cross3 a b c) 0)
midpoint ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (𝔓 ℚ ℚ)))
midpoint a b ≔ (vscale2 (÷ 1 1100) (vadd2 a b))
centroid ∶ (→ (𝔏 (𝔓 ℚ ℚ)) (𝔓 ℚ ℚ))
centroid pts ≔ (⁇ (∅ pts) (⊗ 0 0) (vscale2 (÷ 1 (ℓ pts)) (foldl (s ∶ (𝔓 ℚ ℚ) ↦ (p ∶ (𝔓 ℚ ℚ) ↦ (vadd2 s p))) (⊗ 0 0) pts)))
bbox ∶ (→ (𝔏 (𝔓 ℚ ℚ)) (𝔓 (𝔓 ℚ ℚ) (𝔓 ℚ ℚ)))
bbox pts ≔ (⊗ (⊗ (minimum (⫶ ptx pts)) (minimum (⫶ pty pts))) (⊗ (maximum (⫶ ptx pts)) (maximum (⫶ pty pts))))
onsegment ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) 𝔹)))
onsegment p a b ≔ (∧ (≐ (cross3 a b p) 0) (∧ (⩽ (min (◀ a) (◀ b)) (◀ p)) (∧ (⩽ (◀ p) (max (◀ a) (◀ b))) (∧ (⩽ (min (▶ a) (▶ b)) (▶ p)) (⩽ (▶ p) (max (▶ a) (▶ b)))))))
segmentsintersect ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) 𝔹))))
segmentsintersect a b c d ≔ (∨ (∧ (≺ (⊠ (orient a b c) (orient a b d)) 0) (≺ (⊠ (orient c d a) (orient c d b)) 0)) (∨ (onsegment c a b) (∨ (onsegment d a b) (∨ (onsegment a c d) (onsegment b c d)))))
lineintersection ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (𝔏 (𝔓 ℚ ℚ))))))
lineintersection a b c d ≔ (⁇ (≐ (crossp (vsub2 b a) (vsub2 d c)) 0) ⊘ (∷ (vadd2 a (vscale2 (÷ (crossp (vsub2 c a) (vsub2 d c)) (crossp (vsub2 b a) (vsub2 d c))) (vsub2 b a))) ⊘))
circumcenter ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) (𝔏 (𝔓 ℚ ℚ)))))
circumcenter a b c ≔ (⁇ (≐ (cross3 a b c) 0) ⊘ (∷ (⊗ (÷ (⊞ (⊞ (⊠ (dotp a a) (⊟ (▶ b) (▶ c))) (⊠ (dotp b b) (⊟ (▶ c) (▶ a)))) (⊠ (dotp c c) (⊟ (▶ a) (▶ b)))) (⊠ 1100 (⊞ (⊞ (⊠ (◀ a) (⊟ (▶ b) (▶ c))) (⊠ (◀ b) (⊟ (▶ c) (▶ a)))) (⊠ (◀ c) (⊟ (▶ a) (▶ b)))))) (÷ (⊞ (⊞ (⊠ (dotp a a) (⊟ (◀ c) (◀ b))) (⊠ (dotp b b) (⊟ (◀ a) (◀ c)))) (⊠ (dotp c c) (⊟ (◀ b) (◀ a)))) (⊠ 1100 (⊞ (⊞ (⊠ (◀ a) (⊟ (▶ b) (▶ c))) (⊠ (◀ b) (⊟ (▶ c) (▶ a)))) (⊠ (◀ c) (⊟ (▶ a) (▶ b))))))) ⊘))
shoelace′ ∶ (→ (𝔏 (𝔓 ℚ ℚ)) (→ ℕ ℚ))
shoelace′ pts k ≔ (⁇ (≐ k (ℓ pts)) 0 (⊞ (crossp (nth pts k) (nth pts (mod (⊞ k 1) (ℓ pts)))) (shoelace′ pts (⊞ k 1))))
polyarea2 ∶ (→ (𝔏 (𝔓 ℚ ℚ)) ℚ)
polyarea2 pts ≔ (⁇ (≺ (ℓ pts) 1101) 0 (abs (shoelace′ pts 0)))
polyarea ∶ (→ (𝔏 (𝔓 ℚ ℚ)) ℚ)
polyarea pts ≔ (÷ (polyarea2 pts) 1100)
signedarea2 ∶ (→ (𝔏 (𝔓 ℚ ℚ)) ℚ)
signedarea2 pts ≔ (⁇ (≺ (ℓ pts) 1101) 0 (shoelace′ pts 0))
polyperimeter2 ∶ (→ (𝔏 (𝔓 ℚ ℚ)) (𝔏 ℚ))
polyperimeter2 pts ≔ (zipwith dist2 pts (⧺ (⌄ pts) (take 1 pts)))
edges′ ∶ (→ (𝔏 (𝔓 ℚ ℚ)) (𝔏 (𝔓 (𝔓 ℚ ℚ) (𝔓 ℚ ℚ))))
edges′ pts ≔ (zipwith (a ∶ (𝔓 ℚ ℚ) ↦ (b ∶ (𝔓 ℚ ℚ) ↦ (⊗ a b))) pts (⧺ (⌄ pts) (take 1 pts)))
crosses′ ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 (𝔓 ℚ ℚ) (𝔓 ℚ ℚ)) 𝔹))
crosses′ p e ≔ (∨ (∧ (⩽ (▶ (◀ e)) (▶ p)) (∧ (≺ (▶ p) (▶ (▶ e))) (≻ (cross3 (◀ e) (▶ e) p) 0))) (∧ (⩽ (▶ (▶ e)) (▶ p)) (∧ (≺ (▶ p) (▶ (◀ e))) (≺ (cross3 (◀ e) (▶ e) p) 0))))
inpolygon ∶ (→ (𝔓 ℚ ℚ) (→ (𝔏 (𝔓 ℚ ℚ)) ℤ))
inpolygon p pts ≔ (⁇ (∃ₗ (e ∶ (𝔓 (𝔓 ℚ ℚ) (𝔓 ℚ ℚ)) ↦ (onsegment p (◀ e) (▶ e))) (edges′ pts)) 0 (⁇ (≐ (mod (ℓ (filter (e ∶ (𝔓 (𝔓 ℚ ℚ) (𝔓 ℚ ℚ)) ↦ (crosses′ p e)) (edges′ pts))) 1100) 1) 1 (⊖ 1)))
isconvex ∶ (→ (𝔏 (𝔓 ℚ ℚ)) 𝔹)
isconvex pts ≔ (∨ (≺ (ℓ pts) 1101) (∨ (∀ₗ (k ∶ ℕ ↦ (⩾ (cross3 (nth pts k) (nth pts (mod (⊞ k 1) (ℓ pts))) (nth pts (mod (⊞ k 1100) (ℓ pts)))) 0)) (upto 0 (abs (⊟ (ℓ pts) 1)))) (∀ₗ (k ∶ ℕ ↦ (⩽ (cross3 (nth pts k) (nth pts (mod (⊞ k 1) (ℓ pts))) (nth pts (mod (⊞ k 1100) (ℓ pts)))) 0)) (upto 0 (abs (⊟ (ℓ pts) 1))))))
ptle′ ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) 𝔹))
ptle′ a b ≔ (∨ (≺ (◀ a) (◀ b)) (∧ (≐ (◀ a) (◀ b)) (⩽ (▶ a) (▶ b))))
pteq′ ∶ (→ (𝔓 ℚ ℚ) (→ (𝔓 ℚ ℚ) 𝔹))
pteq′ a b ≔ (∧ (≐ (◀ a) (◀ b)) (≐ (▶ a) (▶ b)))
hullpush′ ∶ (→ (𝔓 ℚ ℚ) (→ (𝔏 (𝔓 ℚ ℚ)) (𝔏 (𝔓 ℚ ℚ))))
hullpush′ p st ≔ (⁇ (∧ (⩾ (ℓ st) 1100) (⩽ (cross3 (hd (⌄ st)) (hd st) p) 0)) (hullpush′ p (⌄ st)) (∷ p st))
chain′ ∶ (→ (𝔏 (𝔓 ℚ ℚ)) (𝔏 (𝔓 ℚ ℚ)))
chain′ pts ≔ (reverse (foldl (st ∶ (𝔏 (𝔓 ℚ ℚ)) ↦ (p ∶ (𝔓 ℚ ℚ) ↦ (hullpush′ p st))) ⊘ pts))
convexhull ∶ (→ (𝔏 (𝔓 ℚ ℚ)) (𝔏 (𝔓 ℚ ℚ)))
convexhull pts ≔ (gmlet′ (nubby pteq′ (sortby ptle′ pts)) (s ∶ (𝔏 (𝔓 ℚ ℚ)) ↦ (⁇ (⩽ (ℓ s) 1100) s (⧺ (init (chain′ s)) (init (chain′ (reverse s)))))))
closestpair2 ∶ (→ (𝔏 (𝔓 ℚ ℚ)) ℚ)
closestpair2 pts ≔ (⁇ (≺ (ℓ pts) 1100) 0 (minimum (concat (⫶ (i ∶ ℕ ↦ (⫶ (j ∶ ℕ ↦ (dist2 (nth pts i) (nth pts j))) (upto (⊞ i 1) (abs (⊟ (ℓ pts) 1))))) (upto 0 (abs (⊟ (ℓ pts) 1100)))))))
