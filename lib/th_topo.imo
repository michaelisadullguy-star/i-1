thcmonoidsig ≔ (lines "infixl 7 ⋆ mop AC\ninfixl 7 mop mop AC\nconst 0 ε munit\nconst 0 munit munit")
thcmonoidrules ∶ (𝔏 𝕊)
thcmonoidrules ≔ (lines "mop(x, munit) ==> x\nmop(munit, x) ==> x")
thcmonoidaxioms ∶ (𝔏 𝕊)
thcmonoidaxioms ≔ (lines "a commutative monoid is a monoid whose operation is commutative:\nM1 (x ⋆ y) ⋆ z = x ⋆ (y ⋆ z)\nM2 x ⋆ ε = x\nM3 ε ⋆ x = x\nM4 x ⋆ y = y ⋆ x\nthe words are multisets: x ⋆ y ⋆ x = x ⋆ x ⋆ y, but still x ⋆ x ≠ x (that is a semilattice)")
thcmonoidtheorems ∶ (𝔏 𝕊)
thcmonoidtheorems ≔ (lines "x ⋆ y = y ⋆ x\nx ⋆ y ⋆ z = z ⋆ y ⋆ x\nx ⋆ y ⋆ x = x ⋆ x ⋆ y\nx ⋆ ε = x\n(x ⋆ y) ⋆ (z ⋆ w) = (x ⋆ z) ⋆ (y ⋆ w)\nx ⋆ y ⋆ ε ⋆ z = z ⋆ x ⋆ y")
thcmonoiddoc ∶ 𝕊
thcmonoiddoc ≔ "commutative monoids: the words are multisets; excludes monoid"
thcmonoid ∶ Theory
thcmonoid ≔ (mktheory "cmonoid" (∷ "core" ⊘) (∷ "monoid" ⊘) ⊥ thcmonoidsig thcmonoidrules ⊘ thcmonoidaxioms thcmonoidtheorems thcmonoiddoc)
