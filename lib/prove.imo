fo′ ε ϕ ξ η λ ≔ ((κ ρ₁ ρ₂ π₁ π₂ ↦ ((∧ (args² λ) (=ᶻ κ ᶜ∧)) (∧³ ρ₁ ρ₂) ((∧ (args² λ) (=ᶻ κ ᶜ∨)) (∨³ ρ₁ ρ₂) ((∧ (args¹ λ) (=ᶻ κ ᶜ¬)) (¬³ ρ₁) ((∧ (args² λ) (=ᶻ κ ᶜ⇒)) (∨³ (¬³ ρ₁) ρ₂) ((∧ (args² λ) (=ᶻ κ ᶜ⇔)) (∧³ (∨³ (¬³ ρ₁) ρ₂) (∨³ (¬³ ρ₂) ρ₁)) ((∧ (args² λ) (=ᶻ κ ᶜ≐ᴿ)) (eqᴾ (⊞ᴾ π₁ (⊖ᴾ π₂))) ((∧ (args² λ) (=ᶻ κ ᶜ≠ᴿ)) (¬³ (eqᴾ (⊞ᴾ π₁ (⊖ᴾ π₂)))) ((∧ (args² λ) (=ᶻ κ ᶜ≺ᴿ)) ((θ ↦ ((∅ θ) ⋖ (sgnᴾ θ))) (⊞ᴾ π₂ (⊖ᴾ π₁))) ((∧ (args² λ) (=ᶻ κ ᶜ≻ᴿ)) ((θ ↦ ((∅ θ) ⋖ (sgnᴾ θ))) (⊞ᴾ π₁ (⊖ᴾ π₂))) ((∧ (args² λ) (=ᶻ κ ᶜ⩽ᴿ)) ((θ ↦ ((∅ θ) ⋗ (¬³ (sgnᴾ (⊖ᴾ θ))))) (⊞ᴾ π₂ (⊖ᴾ π₁))) ((∧ (args² λ) (=ᶻ κ ᶜ⩾ᴿ)) ((θ ↦ ((∅ θ) ⋗ (¬³ (sgnᴾ (⊖ᴾ θ))))) (⊞ᴾ π₁ (⊖ᴾ π₂))) ((υ ↦ ((∧ (◀ υ) (¬ (∅ᶻ ϕ))) (fo ε (⊟ᶻ ϕ (◀ 1)) (▶ υ)) ≖)) (unfold ε ξ)))))))))))))) (symᶜ η) (fo ε ϕ (hd λ)) (fo ε ϕ (hd (⌄ λ))) (normR ε ϕ (hd λ)) (normR ε ϕ (hd (⌄ λ))))
