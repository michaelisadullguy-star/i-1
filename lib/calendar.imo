⍝ lib/calendar.imo — spec notation — trusted prelude — generated by libsrc/build.sh from libsrc/calendar.hum.imo: edit that file, not this one
⍝ calendar.hum.imo -- the Gregorian calendar (human notation; lib/calendar.imo is its translation, made by libsrc/build.sh).
⍝ A date is a triple (year, month, day) written as nested pairs pair(y, pair(m, d)).  A day number is the ordinal of Python's date.toordinal(): day 1 is 0001-01-01.
⍝ The weekday is 0 for Monday … 6 for Sunday, as Python's date.weekday().
isleap ∶ (→ ℤ 𝔹)
isleap y ≔ (∨ (≐ (mod y 11001100000100000000) 0) (∧ (≐ (mod y 111010000) 0) (¬ (≐ (mod y 11101110111010000) 0))))
yearlen ∶ (→ ℤ ℤ)
yearlen y ≔ (⁇ (isleap y) 11001101110100011100 11001101110100010001)
monthlen ∶ (→ ℤ (→ ℤ ℤ))
monthlen y m ≔ (⁇ (≐ m 1100) (⁇ (isleap y) 110000010001 110000010000) (⁇ (∨ (≐ m 111010000) (∨ (≐ m 111011100) (∨ (≐ m 111000001) (≐ m 111001101)))) 110000011100 110000011101))
daysbefore ∶ (→ ℤ (→ ℤ ℤ))
daysbefore y m ≔ (⁇ (⩽ m 1) 0 (⊞ (monthlen y (⊟ m 1)) (daysbefore y (⊟ m 1))))
isvalid ∶ (→ ℤ (→ ℤ (→ ℤ 𝔹)))
isvalid y m d ≔ (∧ (⩾ y 1) (∧ (⩾ m 1) (∧ (⩽ m 100010000) (∧ (⩾ d 1) (⩽ d (monthlen y m))))))
dayofyear ∶ (→ ℤ (→ ℤ (→ ℤ ℤ)))
dayofyear y m d ≔ (⊞ (daysbefore y m) d)
daynumber ∶ (→ ℤ (→ ℤ (→ ℤ ℤ)))
daynumber y m d ≔ (⊞ (⊞ (⊞ (⊟ (⊞ (⊠ 11001101110100010001 (⊟ y 1)) (div (⊟ y 1) 111010000)) (div (⊟ y 1) 11101110111010000)) (div (⊟ y 1) 11001100000100000000)) (daysbefore y m)) d)
monthof′ ∶ (→ ℤ (→ ℤ (→ ℤ ℤ)))
monthof′ y k m ≔ (⁇ (≺ k (monthlen y m)) m (monthof′ y (⊟ k (monthlen y m)) (⊞ m 1)))
dayof′ ∶ (→ ℤ (→ ℤ (→ ℤ ℤ)))
dayof′ y k m ≔ (⁇ (≺ k (monthlen y m)) (⊞ k 1) (dayof′ y (⊟ k (monthlen y m)) (⊞ m 1)))
centuryc′ ∶ (→ ℤ ℤ)
centuryc′ n ≔ (min (div (mod n 110111010000110011011100110100000001) 111000001000111011100110100010000) 1101)
quadc′ ∶ (→ ℤ ℤ)
quadc′ n ≔ (div (⊟ (mod n 110111010000110011011100110100000001) (⊠ (centuryc′ n) 111000001000111011100110100010000)) 1110111000001000011010001)
yearc′ ∶ (→ ℤ ℤ)
yearc′ n ≔ (min (div (mod (⊟ (mod n 110111010000110011011100110100000001) (⊠ (centuryc′ n) 111000001000111011100110100010000)) 1110111000001000011010001) 11001101110100010001) 1101)
cycleyear′ ∶ (→ ℤ ℤ)
cycleyear′ n ≔ (⊞ (⊞ (⊞ (⊞ (⊠ (div n 110111010000110011011100110100000001) 11001100000100000000) (⊠ (centuryc′ n) 11101110111010000)) (⊠ (quadc′ n) 111010000)) (yearc′ n)) 1)
fromdaynumber ∶ (→ ℤ (𝔓 ℤ (𝔓 ℤ ℤ)))
fromdaynumber n ≔ (⊗ (cycleyear′ (⊟ n 1)) (⊗ (monthof′ (cycleyear′ (⊟ n 1)) (⊟ n (daynumber (cycleyear′ (⊟ n 1)) 1 1)) 1) (dayof′ (cycleyear′ (⊟ n 1)) (⊟ n (daynumber (cycleyear′ (⊟ n 1)) 1 1)) 1)))
weekday ∶ (→ ℤ ℤ)
weekday n ≔ (mod (⊞ n 111011100) 111011101)
weekdayof ∶ (→ ℤ (→ ℤ (→ ℤ ℤ)))
weekdayof y m d ≔ (weekday (daynumber y m d))
datediff ∶ (→ ℤ (→ ℤ (→ ℤ (→ ℤ (→ ℤ (→ ℤ ℤ))))))
datediff ya ma da yb mb db ≔ (⊟ (daynumber yb mb db) (daynumber ya ma da))
adddays ∶ (→ ℤ (→ ℤ (→ ℤ (→ ℤ (𝔓 ℤ (𝔓 ℤ ℤ))))))
adddays y m d k ≔ (fromdaynumber (⊞ (daynumber y m d) k))
isoyear ∶ (→ ℤ ℤ)
isoyear n ≔ (◀ (fromdaynumber (⊞ (⊟ n (weekday n)) 1101)))
isoweek ∶ (→ ℤ ℤ)
isoweek n ≔ (⊞ (div (⊟ (⊞ (⊟ n (weekday n)) 1101) (daynumber (isoyear n) 1 1)) 111011101) 1)
easterh′ ∶ (→ ℤ ℤ)
easterh′ y ≔ (mod (⊞ (⊟ (⊟ (⊞ (⊠ 100001101 (mod y 100001101)) (div y 11101110111010000)) (div (div y 11101110111010000) 111010000)) (div (⊞ (⊟ (div y 11101110111010000) (div (⊞ (div y 11101110111010000) 111000000) 110011000001)) 1) 1101)) 100011101) 110000011100)
easterl′ ∶ (→ ℤ ℤ)
easterl′ y ≔ (mod (⊟ (⊟ (⊞ (⊞ 110000000000 (⊠ 1100 (mod (div y 11101110111010000) 111010000))) (⊠ 1100 (div (mod y 11101110111010000) 111010000))) (easterh′ y)) (mod (mod y 11101110111010000) 111010000)) 111011101)
easterm′ ∶ (→ ℤ ℤ)
easterm′ y ≔ (div (⊞ (⊞ (mod y 100001101) (⊠ 111001101 (easterh′ y))) (⊠ 110011011100 (easterl′ y))) 11000001000000001101)
easterx′ ∶ (→ ℤ ℤ)
easterx′ y ≔ (⊞ (⊟ (⊞ (easterh′ y) (easterl′ y)) (⊠ 111011101 (easterm′ y))) 11101110100001100)
easter ∶ (→ ℤ (𝔓 ℤ ℤ))
easter y ≔ (⊗ (div (easterx′ y) 110000011101) (⊞ (mod (easterx′ y) 110000011101) 1))
monthname ∶ (→ ℕ 𝕊)
monthname m ≔ (nth (∷ "" (∷ "January" (∷ "February" (∷ "March" (∷ "April" (∷ "May" (∷ "June" (∷ "July" (∷ "August" (∷ "September" (∷ "October" (∷ "November" (∷ "December" ⊘))))))))))))) m)
dayname ∶ (→ ℕ 𝕊)
dayname w ≔ (nth (∷ "Monday" (∷ "Tuesday" (∷ "Wednesday" (∷ "Thursday" (∷ "Friday" (∷ "Saturday" (∷ "Sunday" ⊘))))))) w)
isodate ∶ (→ ℕ (→ ℕ (→ ℕ 𝕊)))
isodate y m d ≔ (⧺ (padleft 111010000 '0' (showbase y 111001100)) (⧺ "-" (⧺ (padleft 1100 '0' (showbase m 111001100)) (⧺ "-" (padleft 1100 '0' (showbase d 111001100))))))
isofield′ ∶ (→ 𝕊 (→ ℕ (𝔏 ℕ)))
isofield′ s k ≔ (readnat (nth (splitstr "-" s) k))
parseisodate ∶ (→ 𝕊 (𝔏 (𝔓 ℕ (𝔓 ℕ ℕ))))
parseisodate s ≔ (⁇ (∧ (≐ (ℓ (splitstr "-" s)) 1101) (∧ (¬ (∅ (isofield′ s 0))) (∧ (¬ (∅ (isofield′ s 1))) (∧ (¬ (∅ (isofield′ s 1100))) (isvalid (hd (isofield′ s 0)) (hd (isofield′ s 1)) (hd (isofield′ s 1100))))))) (∷ (⊗ (hd (isofield′ s 0)) (⊗ (hd (isofield′ s 1)) (hd (isofield′ s 1100)))) ⊘) ⊘)
