⍝ lib/stats.imo — spec notation — trusted prelude — generated by libsrc/build.sh from libsrc/stats.hum.imo: edit that file, not this one
⍝ stats.hum.imo -- exact statistics on lists of rational numbers (human notation; lib/stats.imo is its translation, made by libsrc/build.sh).
⍝ Every result is an exact rational; the variance is the population variance, svariance the sample variance; correlation2 is the square of Pearson's coefficient (no square root is needed).
slet′ ∶ (→ α (→ (→ α β) β))
slet′ x f ≔ (f x)
total ∶ (→ (𝔏 ℚ) ℚ)
total xs ≔ (sumof xs)
average ∶ (→ (𝔏 ℚ) ℚ)
average xs ≔ (⁇ (∅ xs) 0 (÷ (sumof xs) (ℓ xs)))
spread ∶ (→ (𝔏 ℚ) ℚ)
spread xs ≔ (⁇ (∅ xs) 0 (⊟ (maximum xs) (minimum xs)))
medsorted′ ∶ (→ (𝔏 ℚ) (→ ℕ ℚ))
medsorted′ s k ≔ (⁇ (≐ (mod (ℓ s) 1100) 1) (nth s k) (÷ (⊞ (nth s k) (last (take k s))) 1100))
median ∶ (→ (𝔏 ℚ) ℚ)
median xs ≔ (⁇ (∅ xs) 0 (medsorted′ (sort xs) (div (ℓ xs) 1100)))
modes ∶ (→ (𝔏 ℚ) (𝔏 ℚ))
modes xs ≔ (⁇ (∅ xs) ⊘ (⫶ (p ∶ (𝔓 ℚ ℕ) ↦ (◀ p)) (filter (p ∶ (𝔓 ℚ ℕ) ↦ (≐ (▶ p) (maximum (⫶ (q ∶ (𝔓 ℚ ℕ) ↦ (▶ q)) (tally xs))))) (tally xs))))
variance ∶ (→ (𝔏 ℚ) ℚ)
variance xs ≔ (⁇ (∅ xs) 0 (slet′ (average xs) (m ∶ ℚ ↦ (÷ (sumof (⫶ (x ∶ ℚ ↦ (⊠ (⊟ x m) (⊟ x m))) xs)) (ℓ xs)))))
svariance ∶ (→ (𝔏 ℚ) ℚ)
svariance xs ≔ (⁇ (⩽ (ℓ xs) 1) 0 (slet′ (average xs) (m ∶ ℚ ↦ (÷ (sumof (⫶ (x ∶ ℚ ↦ (⊠ (⊟ x m) (⊟ x m))) xs)) (⊟ (ℓ xs) 1)))))
qinterp′ ∶ (→ (𝔏 ℚ) (→ ℚ ℚ))
qinterp′ s h ≔ (slet′ (abs (⌊ h)) (lo ∶ ℕ ↦ (⊞ (nth s lo) (⊠ (⊟ h lo) (⊟ (nth s (min (⊞ lo 1) (abs (⊟ (ℓ s) 1)))) (nth s lo))))))
quantile ∶ (→ ℚ (→ (𝔏 ℚ) ℚ))
quantile p xs ≔ (⁇ (∅ xs) 0 (qinterp′ (sort xs) (⊠ (⊟ (ℓ xs) 1) p)))
iqr ∶ (→ (𝔏 ℚ) ℚ)
iqr xs ≔ (⊟ (quantile (÷ 1101 111010000) xs) (quantile (÷ 1 111010000) xs))
covariance ∶ (→ (𝔏 ℚ) (→ (𝔏 ℚ) ℚ))
covariance xs ys ≔ (⁇ (∨ (∅ xs) (∅ ys)) 0 (⊟ (÷ (sumof (zipwith (x ∶ ℚ ↦ (y ∶ ℚ ↦ (⊠ x y))) xs ys)) (min (ℓ xs) (ℓ ys))) (⊠ (average (take (min (ℓ xs) (ℓ ys)) xs)) (average (take (min (ℓ xs) (ℓ ys)) ys)))))
correlation2 ∶ (→ (𝔏 ℚ) (→ (𝔏 ℚ) ℚ))
correlation2 xs ys ≔ (⁇ (∨ (≐ (variance xs) 0) (≐ (variance ys) 0)) 0 (÷ (⊠ (covariance xs ys) (covariance xs ys)) (⊠ (variance xs) (variance ys))))
linreg ∶ (→ (𝔏 ℚ) (→ (𝔏 ℚ) (𝔓 ℚ ℚ)))
linreg xs ys ≔ (⁇ (≐ (variance xs) 0) (⊗ 0 (average ys)) (⊗ (÷ (covariance xs ys) (variance xs)) (⊟ (average ys) (⊠ (÷ (covariance xs ys) (variance xs)) (average xs)))))
cumsum ∶ (→ (𝔏 ℚ) (𝔏 ℚ))
cumsum xs ≔ (scanl₁ (a ∶ ℚ ↦ (b ∶ ℚ ↦ (⊞ a b))) xs)
movingavg ∶ (→ ℕ (→ (𝔏 ℚ) (𝔏 ℚ)))
movingavg k xs ≔ (⁇ (≐ k 0) ⊘ (⫶ (w ∶ (𝔏 ℚ) ↦ (÷ (sumof w) k)) (windows k xs)))
weightedmean ∶ (→ (𝔏 ℚ) (→ (𝔏 ℚ) ℚ))
weightedmean ws xs ≔ (⁇ (≐ (sumof ws) 0) 0 (÷ (sumof (zipwith (w ∶ ℚ ↦ (x ∶ ℚ ↦ (⊠ w x))) ws xs)) (sumof ws)))
ranks ∶ (→ (𝔏 ℚ) (𝔏 ℚ))
ranks xs ≔ (⫶ (x ∶ ℚ ↦ (⊞ (count (y ∶ ℚ ↦ (≺ y x)) xs) (÷ (⊞ (count (y ∶ ℚ ↦ (≐ y x)) xs) 1) 1100))) xs)
