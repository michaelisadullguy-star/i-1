⍝ lib/graph.imo — spec notation — trusted prelude — generated by libsrc/build.sh from libsrc/graph.hum.imo: edit that file, not this one
⍝ graph.hum.imo -- graphs (human notation; lib/graph.imo is its translation, made by libsrc/build.sh).
⍝ A graph is a dictionary from vertices (integers) to the lists of their neighbours, Dict(List(\Z)), in the order in which the edges were given; an edge list is a
⍝ list of pairs.  A weighted graph maps a vertex to the list of (neighbour, weight) pairs, Dict(List(Pair(\Z, \QQ))); a weighted edge is pair(u, pair(v, w)).
⍝ breadth-first search: the vertices reachable from s, in the order in which they are first reached
⍝ depth-first search: preorder, the neighbours in the order of their lists
⍝ connected components of an undirected graph: lists of vertices in the order of BFS from the least unvisited vertex
⍝ distances (numbers of edges) from s to the vertices reachable from it
⍝ a shortest path (fewest edges) from s to t, found by breadth-first search: the list of vertices from s to t, or the empty list (a maybe: a list of at most one path)
⍝ topological order by Kahn's algorithm (the vertices without incoming edges first, in the order of the keys of the dictionary); a cycle leaves its vertices, and everything after
⍝ them, out of the result
⍝ an undirected graph is bipartite when every edge joins vertices whose distances from the root of their component have different parities
⍝ weighted graphs
⍝ Dijkstra's algorithm (non-negative weights): the distances from s to the vertices reachable from it
⍝ Kruskal's algorithm: a minimum spanning forest of an undirected weighted graph given by its edge list pair(u, pair(v, w)); the edges are taken in the order of their weights
⍝ (a stable sort), and the forest is returned as a list of edges
ensure′ ∶ (→ ℤ[i] (→ (Dict (𝔏 ℤ[i])) (Dict (𝔏 ℤ[i]))))
ensure′ v g ≔ (⁇ (dhas v g) g (dput v ⊘ g))
addedge′ ∶ (→ ℤ[i] (→ ℤ[i] (→ (Dict (𝔏 ℤ[i])) (Dict (𝔏 ℤ[i])))))
addedge′ u v g ≔ (dwith (new ∶ (𝔏 ℤ[i]) ↦ (old ∶ (𝔏 ℤ[i]) ↦ (⧺ old new))) u (∷ v ⊘) (ensure′ v g))
digraph ∶ (→ (𝔏 ℤ[i]) (→ (𝔏 (𝔓 ℤ[i] ℤ[i])) (Dict (𝔏 ℤ[i]))))
digraph vs es ≔ (foldl (g ∶ (Dict (𝔏 ℤ[i])) ↦ (e ∶ (𝔓 ℤ[i] ℤ[i]) ↦ (addedge′ (◀ e) (▶ e) g))) (foldl (g ∶ (Dict (𝔏 ℤ[i])) ↦ (v ∶ ℤ[i] ↦ (ensure′ v g))) emptydict vs) es)
ugraph ∶ (→ (𝔏 ℤ[i]) (→ (𝔏 (𝔓 ℤ[i] ℤ[i])) (Dict (𝔏 ℤ[i]))))
ugraph vs es ≔ (foldl (g ∶ (Dict (𝔏 ℤ[i])) ↦ (e ∶ (𝔓 ℤ[i] ℤ[i]) ↦ (⁇ (≐ (◀ e) (▶ e)) (addedge′ (◀ e) (▶ e) g) (addedge′ (▶ e) (◀ e) (addedge′ (◀ e) (▶ e) g))))) (foldl (g ∶ (Dict (𝔏 ℤ[i])) ↦ (v ∶ ℤ[i] ↦ (ensure′ v g))) emptydict vs) es)
neighbors ∶ (→ (Dict (𝔏 ℤ[i])) (→ ℤ[i] (𝔏 ℤ[i])))
neighbors g v ≔ (dgetd v ⊘ g)
vertices ∶ (→ (Dict (𝔏 ℤ[i])) (𝔏 ℤ[i]))
vertices g ≔ (dkeys g)
degree ∶ (→ (Dict (𝔏 ℤ[i])) (→ ℤ[i] ℕ))
degree g v ≔ (ℓ (neighbors g v))
edges ∶ (→ (Dict (𝔏 ℤ[i])) (𝔏 (𝔓 ℤ[i] ℤ[i])))
edges g ≔ (concat (⫶ (p ∶ (𝔓 ℤ[i] (𝔏 ℤ[i])) ↦ (⫶ (w ∶ ℤ[i] ↦ (⊗ (◀ p) w)) (▶ p))) (ditems g)))
reversed ∶ (→ (Dict (𝔏 ℤ[i])) (Dict (𝔏 ℤ[i])))
reversed g ≔ (digraph (vertices g) (⫶ (e ∶ (𝔓 ℤ[i] ℤ[i]) ↦ (⊗ (▶ e) (◀ e))) (edges g)))
glet′ ∶ (→ α (→ (→ α β) β))
glet′ x f ≔ (f x)
bfsexpand′ ∶ (→ (Dict (𝔏 ℤ[i])) (→ ℤ[i] (→ (Queue ℤ[i]) (→ FSet (𝔓 (Queue ℤ[i]) FSet)))))
bfsexpand′ g v q seen ≔ (foldl (st ∶ (𝔓 (Queue ℤ[i]) FSet) ↦ (w ∶ ℤ[i] ↦ (⁇ (fshas w (▶ st)) st (⊗ (qpush w (◀ st)) (fsadd w (▶ st)))))) (⊗ q seen) (neighbors g v))
bfsgo′ ∶ (→ (Dict (𝔏 ℤ[i])) (→ (Queue ℤ[i]) (→ FSet (→ (𝔏 ℤ[i]) (𝔏 ℤ[i])))))
bfsgo′ g q seen acc ≔ (⁇ (qempty q) (reverse acc) (glet′ (bfsexpand′ g (hd (qpeek q)) (qpop q) seen) (r ∶ (𝔓 (Queue ℤ[i]) FSet) ↦ (bfsgo′ g (◀ r) (▶ r) (∷ (hd (qpeek q)) acc)))))
bfs ∶ (→ (Dict (𝔏 ℤ[i])) (→ ℤ[i] (𝔏 ℤ[i])))
bfs g s ≔ (bfsgo′ g (qpush s emptyqueue) (fsadd s emptyfset) ⊘)
dfsgo′ ∶ (→ (Dict (𝔏 ℤ[i])) (→ (𝔏 ℤ[i]) (→ FSet (→ (𝔏 ℤ[i]) (𝔏 ℤ[i])))))
dfsgo′ g stack seen acc ≔ (⁇ (∅ stack) (reverse acc) (⁇ (fshas (hd stack) seen) (dfsgo′ g (⌄ stack) seen acc) (dfsgo′ g (⧺ (neighbors g (hd stack)) (⌄ stack)) (fsadd (hd stack) seen) (∷ (hd stack) acc))))
dfs ∶ (→ (Dict (𝔏 ℤ[i])) (→ ℤ[i] (𝔏 ℤ[i])))
dfs g s ≔ (dfsgo′ g (∷ s ⊘) emptyfset ⊘)
reachable ∶ (→ (Dict (𝔏 ℤ[i])) (→ ℤ[i] (→ ℤ[i] 𝔹)))
reachable g s t ≔ (elem t (bfs g s))
compsgo′ ∶ (→ (Dict (𝔏 ℤ[i])) (→ (𝔏 ℤ[i]) (→ FSet (→ (𝔏 (𝔏 ℤ[i])) (𝔏 (𝔏 ℤ[i]))))))
compsgo′ g vs seen acc ≔ (⁇ (∅ vs) (reverse acc) (⁇ (fshas (hd vs) seen) (compsgo′ g (⌄ vs) seen acc) (glet′ (bfs g (hd vs)) (c ∶ (𝔏 ℤ[i]) ↦ (compsgo′ g (⌄ vs) (foldl (s ∶ FSet ↦ (w ∶ ℤ[i] ↦ (fsadd w s))) seen c) (∷ c acc))))))
components ∶ (→ (Dict (𝔏 ℤ[i])) (𝔏 (𝔏 ℤ[i])))
components g ≔ (compsgo′ g (vertices g) emptyfset ⊘)
distgo′ ∶ (→ (Dict (𝔏 ℤ[i])) (→ (Queue ℤ[i]) (→ (Dict ℤ) (Dict ℤ))))
distgo′ g q d ≔ (⁇ (qempty q) d (glet′ (hd (qpeek q)) (v ∶ ℤ[i] ↦ (distgo′ g (foldl (qq ∶ (Queue ℤ[i]) ↦ (w ∶ ℤ[i] ↦ (⁇ (dhas w d) qq (qpush w qq)))) (qpop q) (neighbors g v)) (foldl (dd ∶ (Dict ℤ) ↦ (w ∶ ℤ[i] ↦ (⁇ (dhas w dd) dd (dput w (⊞ (dgetd v 0 d) 1) dd)))) d (neighbors g v))))))
distances ∶ (→ (Dict (𝔏 ℤ[i])) (→ ℤ[i] (Dict ℤ)))
distances g s ≔ (distgo′ g (qpush s emptyqueue) (dput s 0 emptydict))
pargo′ ∶ (→ (Dict (𝔏 ℤ[i])) (→ (Queue ℤ[i]) (→ (Dict ℤ[i]) (Dict ℤ[i]))))
pargo′ g q par ≔ (⁇ (qempty q) par (glet′ (hd (qpeek q)) (v ∶ ℤ[i] ↦ (pargo′ g (foldl (qq ∶ (Queue ℤ[i]) ↦ (w ∶ ℤ[i] ↦ (⁇ (dhas w par) qq (qpush w qq)))) (qpop q) (neighbors g v)) (foldl (pp ∶ (Dict ℤ[i]) ↦ (w ∶ ℤ[i] ↦ (⁇ (dhas w pp) pp (dput w v pp)))) par (neighbors g v))))))
unwind′ ∶ (→ (Dict ℤ[i]) (→ ℤ[i] (→ ℤ[i] (→ (𝔏 ℤ[i]) (𝔏 ℤ[i])))))
unwind′ par s v acc ≔ (⁇ (≐ v s) (∷ s acc) (unwind′ par s (dgetd v s par) (∷ v acc)))
shortestpath ∶ (→ (Dict (𝔏 ℤ[i])) (→ ℤ[i] (→ ℤ[i] (𝔏 (𝔏 ℤ[i])))))
shortestpath g s t ≔ (glet′ (pargo′ g (qpush s emptyqueue) (dput s s emptydict)) (par ∶ (Dict ℤ[i]) ↦ (⁇ (dhas t par) (∷ (unwind′ par s t ⊘) ⊘) ⊘)))
indeg′ ∶ (→ (Dict (𝔏 ℤ[i])) (Dict ℤ))
indeg′ g ≔ (foldl (d ∶ (Dict ℤ) ↦ (e ∶ (𝔓 ℤ[i] ℤ[i]) ↦ (dput (▶ e) (⊞ (dgetd (▶ e) 0 d) 1) d))) (foldl (d ∶ (Dict ℤ) ↦ (v ∶ ℤ[i] ↦ (dput v 0 d))) emptydict (vertices g)) (edges g))
topogo′ ∶ (→ (Dict (𝔏 ℤ[i])) (→ (Queue ℤ[i]) (→ (Dict ℤ) (→ (𝔏 ℤ[i]) (𝔏 ℤ[i])))))
topogo′ g q d acc ≔ (⁇ (qempty q) (reverse acc) (glet′ (hd (qpeek q)) (v ∶ ℤ[i] ↦ (glet′ (foldl (st ∶ (𝔓 (Queue ℤ[i]) (Dict ℤ)) ↦ (w ∶ ℤ[i] ↦ (⁇ (≐ (dgetd w 0 (▶ st)) 1) (⊗ (qpush w (◀ st)) (dput w 0 (▶ st))) (⊗ (◀ st) (dput w (⊟ (dgetd w 0 (▶ st)) 1) (▶ st)))))) (⊗ (qpop q) d) (neighbors g v)) (r ∶ (𝔓 (Queue ℤ[i]) (Dict ℤ)) ↦ (topogo′ g (◀ r) (▶ r) (∷ v acc)))))))
toposort ∶ (→ (Dict (𝔏 ℤ[i])) (𝔏 ℤ[i]))
toposort g ≔ (topogo′ g (foldl (q ∶ (Queue ℤ[i]) ↦ (v ∶ ℤ[i] ↦ (qpush v q))) emptyqueue (filter (v ∶ ℤ[i] ↦ (≐ (dgetd v 0 (indeg′ g)) 0)) (vertices g))) (indeg′ g) ⊘)
isacyclic ∶ (→ (Dict (𝔏 ℤ[i])) 𝔹)
isacyclic g ≔ (≐ (ℓ (toposort g)) (dsize g))
parity′ ∶ (→ (Dict ℤ) (→ ℤ[i] ℤ[i]))
parity′ d v ≔ (mod (dgetd v 0 d) 1100)
bipcomp′ ∶ (→ (Dict (𝔏 ℤ[i])) (→ (𝔏 ℤ[i]) 𝔹))
bipcomp′ g c ≔ (glet′ (distances g (hd c)) (d ∶ (Dict ℤ) ↦ (∀ₗ (v ∶ ℤ[i] ↦ (∀ₗ (w ∶ ℤ[i] ↦ (¬ (≐ (parity′ d v) (parity′ d w)))) (neighbors g v))) c)))
isbipartite ∶ (→ (Dict (𝔏 ℤ[i])) 𝔹)
isbipartite g ≔ (∀ₗ (c ∶ (𝔏 ℤ[i]) ↦ (bipcomp′ g c)) (components g))
isconnected ∶ (→ (Dict (𝔏 ℤ[i])) 𝔹)
isconnected g ≔ (⩽ (ℓ (components g)) 1)
wensure′ ∶ (→ ℤ[i] (→ (Dict (𝔏 (𝔓 ℤ[i] ℚ))) (Dict (𝔏 (𝔓 ℤ[i] ℚ)))))
wensure′ v g ≔ (⁇ (dhas v g) g (dput v ⊘ g))
waddedge′ ∶ (→ ℤ[i] (→ ℤ[i] (→ ℚ (→ (Dict (𝔏 (𝔓 ℤ[i] ℚ))) (Dict (𝔏 (𝔓 ℤ[i] ℚ)))))))
waddedge′ u v w g ≔ (dwith (new ∶ (𝔏 (𝔓 ℤ[i] ℚ)) ↦ (old ∶ (𝔏 (𝔓 ℤ[i] ℚ)) ↦ (⧺ old new))) u (∷ (⊗ v w) ⊘) (wensure′ v g))
wdigraph ∶ (→ (𝔏 ℤ[i]) (→ (𝔏 (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ))) (Dict (𝔏 (𝔓 ℤ[i] ℚ)))))
wdigraph vs es ≔ (foldl (g ∶ (Dict (𝔏 (𝔓 ℤ[i] ℚ))) ↦ (e ∶ (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ)) ↦ (waddedge′ (◀ e) (◀ (▶ e)) (▶ (▶ e)) g))) (foldl (g ∶ (Dict (𝔏 (𝔓 ℤ[i] ℚ))) ↦ (v ∶ ℤ[i] ↦ (wensure′ v g))) emptydict vs) es)
wugraph ∶ (→ (𝔏 ℤ[i]) (→ (𝔏 (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ))) (Dict (𝔏 (𝔓 ℤ[i] ℚ)))))
wugraph vs es ≔ (foldl (g ∶ (Dict (𝔏 (𝔓 ℤ[i] ℚ))) ↦ (e ∶ (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ)) ↦ (⁇ (≐ (◀ e) (◀ (▶ e))) (waddedge′ (◀ e) (◀ (▶ e)) (▶ (▶ e)) g) (waddedge′ (◀ (▶ e)) (◀ e) (▶ (▶ e)) (waddedge′ (◀ e) (◀ (▶ e)) (▶ (▶ e)) g))))) (foldl (g ∶ (Dict (𝔏 (𝔓 ℤ[i] ℚ))) ↦ (v ∶ ℤ[i] ↦ (wensure′ v g))) emptydict vs) es)
relax′ ∶ (→ (Heap ℤ[i]) (→ ℚ (→ ℤ[i] (→ (𝔏 (𝔓 ℤ[i] ℚ)) (Heap ℤ[i])))))
relax′ h d v ws ≔ (foldl (hh ∶ (Heap ℤ[i]) ↦ (p ∶ (𝔓 ℤ[i] ℚ) ↦ (hpush (⊞ d (▶ p)) (◀ p) hh))) h ws)
dijgo′ ∶ (→ (Dict (𝔏 (𝔓 ℤ[i] ℚ))) (→ (Heap ℤ[i]) (→ (Dict ℚ) (Dict ℚ))))
dijgo′ g h dist ≔ (⁇ (hempty h) dist (glet′ (hd (hpeek h)) (top ∶ (𝔓 ℚ ℤ[i]) ↦ (⁇ (dhas (▶ top) dist) (dijgo′ g (hpop h) dist) (dijgo′ g (relax′ (hpop h) (◀ top) (▶ top) (dgetd (▶ top) ⊘ g)) (dput (▶ top) (◀ top) dist))))))
dijkstra ∶ (→ (Dict (𝔏 (𝔓 ℤ[i] ℚ))) (→ ℤ[i] (Dict ℚ)))
dijkstra g s ≔ (dijgo′ g (hpush 0 s emptyheap) emptydict)
find′ ∶ (→ (Dict ℤ[i]) (→ ℤ[i] ℤ[i]))
find′ par x ≔ (⁇ (≐ (dgetd x x par) x) x (find′ par (dgetd x x par)))
kruskalgo′ ∶ (→ (Dict ℤ[i]) (→ (𝔏 (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ))) (→ (𝔏 (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ))) (𝔏 (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ))))))
kruskalgo′ par es acc ≔ (⁇ (∅ es) (reverse acc) (⁇ (≐ (find′ par (◀ (hd es))) (find′ par (◀ (▶ (hd es))))) (kruskalgo′ par (⌄ es) acc) (kruskalgo′ (dput (find′ par (◀ (hd es))) (find′ par (◀ (▶ (hd es)))) par) (⌄ es) (∷ (hd es) acc))))
kruskal ∶ (→ (𝔏 (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ))) (𝔏 (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ))))
kruskal es ≔ (kruskalgo′ emptydict (sortby (a ∶ (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ)) ↦ (b ∶ (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ)) ↦ (⩽ (▶ (▶ a)) (▶ (▶ b))))) es) ⊘)
mstweight ∶ (→ (𝔏 (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ))) ℚ)
mstweight es ≔ (sumof (⫶ (e ∶ (𝔓 ℤ[i] (𝔓 ℤ[i] ℚ)) ↦ (▶ (▶ e))) (kruskal es)))
