+ := ⊞ | ⊕ | ⊞𝔻 | ∨ | ∪ | ∨Ω | madd | addz2 ; infixl 6
- := ⊟ | ⊟ᴿ | ⊟𝔻 | msub | subz2 ; infixl 6
* := ⊠ | ⊛ | ⊠𝔻 | ∧ | ∩ | ∧Ω | mmul | mvec | mscale | scalez2 ; infixl 7
/ := ÷ | ÷ᴿ ; infixl 7
- := ⊖ | ⊖ᴿ | ⊖𝔻 | mneg | negz2 ; prefix 8
== := ≐ | ≐ˢ | ≐ᴿ | eqz2 ; infix 4
!= := ≠ | ≠ᴿ ; infix 4
geq := ⩾ | ⩾ᴿ ; infix 4
leq := ⩽ | ⩽ᴿ ; infix 4
gt := ≻ | ≻ᴿ ; infix 4
lt := ≺ | ≺ᴿ ; infix 4
