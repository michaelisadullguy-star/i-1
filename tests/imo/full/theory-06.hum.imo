  "denv: ⟨⟨2 * x - 1 <= x - 2 * y + z + 2⟩ && ⟨2 * z <= -x - 2 * y + z + 1⟩ && ⟨2 * y + 2 * z + 2 < y + z⟩⟩ => ⟨2 * x - 1 < -x + y + 2 * z⟩",
  "denv: ⟨⟨-2 * x - 2 * y + z + 2 <= -z + 2⟩ && ⟨-y - 2 * z + 2 < -2 * y + z - 1⟩ && ⟨x + y + z + 2 < -x + 2 * y⟩⟩ => ⟨-x - y + 2 * z + 2 <= x ",
  "denv: ⟨⟨x + y - 2 * z <= 2 * x + 2 * y + 2 * z + 2⟩ && ⟨2 * x + y + 1 < -2 * x + y + 1⟩ && ⟨-2 * x - 2 * y + 2 * z < 2 * x + 2 * y - 2 * z +",
  "denv: ⟨⟨x - y + z <= x + 2 * y + z⟩ && ⟨2 * z + 1 <= -2 * z⟩⟩ => ⟨x <= -2 * x + y + 1⟩",
  "denv: ⟨⟨y - z - 1 < -x + y - 1⟩ && ⟨2 * x - 2 * y - 2 * z <= -2 * x - 2 * z + 1⟩⟩ => ⟨-z < -2 * z + 1⟩",
  "denv: ⟨⟨2 * x + 2 * y <= 2 * x - 2 * y + 2 * z⟩⟩ => ⟨-x - 2 * y + 1 < 2 * x + 2 * y - 2 * z + 1⟩",
  "denv: ⟨⟨x - 2 * y + 2 * z + 1 < -2 * y - 2 * z - 1⟩⟩ => ⟨x - y - 1 <= -2 * y - 2 * z⟩",
  "denv: ⟨⟨-y + 2 < -2 * y + z + 2⟩ && ⟨2 * x - y <= 2 * x - 2 * y - z⟩ && ⟨y + 2 * z - 1 <= -z⟩⟩ => ⟨-x + 2 * y - 2 * z < x - 1⟩",
  "wenv: x = x",
  "wenv: ⟨-2 * x⟩ <= z",
  "wenv: abs⟨⟨-y⟩⟩ < y",
  "wenv: ⟨2 * abs⟨max⟨1, x⟩⟩⟩ < max⟨⟨-z⟩, x⟩",
  "wenv: x > ⟨⟨-z⟩ - abs⟨y⟩⟩",
  "wenv: ⟨-1 * abs⟨x⟩⟩ = x",
  "wenv: ⟨-1⟩ >= abs⟨abs⟨1⟩⟩",
  "wenv: min⟨z, min⟨y, y⟩⟩ <= min⟨⟨-1⟩, x⟩",
  "wenv: ⟨-max⟨y, 0⟩⟩ <= abs⟨x⟩",
  "wenv: ⟨-y⟩ <= ⟨-1⟩",
  "wenv: min⟨abs⟨z⟩, ⟨⟨-1⟩ - ⟨-1⟩⟩⟩ <= ⟨⟨-2⟩ - y⟩",
