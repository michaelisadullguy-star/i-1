-- characters and strings: checks 751 to 767 of 767.  Generated by tests/langtest.py from tests/test_strings.py: the expected values were computed by independent Python oracles;
-- run it with  ./i1 --impl NAME run THIS_FILE  on any core: it prints  PASS n  when every check holds, and  FAIL  and the labels of the failed checks otherwise.
checkvalues in List(Bool) := [((unrle("3a1b2c")) == ("aaabcc")),
  ((rle("zzzzzzzzzzzz")) == ("12z")),
  ((unrle("12z")) == ("zzzzzzzzzzzz")),
  ((rle("abab")) == ("1a1b1a1b")),
  ((unrle("1a1b1a1b")) == ("abab")),
  ((rle("")) == ("")),
  ((unrle("")) == ("")),
  ((rle("bab")) == ("1b1a1b")),
  ((unrle("1b1a1b")) == ("bab")),
  ((rle("a")) == ("1a")),
  ((unrle("1a")) == ("a")),
  ((rle("ccbcb")) == ("2c1b1c1b")),
  ((unrle("2c1b1c1b")) == ("ccbcb")),
  ((rle("caabcbcccbaaca")) == ("1c2a1b1c1b3c1b2a1c1a")),
  ((unrle("1c2a1b1c1b3c1b2a1c1a")) == ("caabcbcccbaaca")),
  ((rle("bccbcabcabc")) == ("1b2c1b1c1a1b1c1a1b1c")),
  ((unrle("1b2c1b1c1a1b1c1a1b1c")) == ("bccbcabcabc"))]
checklabels in List(String) := ["unrle '3a1b2c'",
  "rle 'zzzzzzzzzzzz'",
  "unrle '12z'",
  "rle 'abab'",
  "unrle '1a1b1a1b'",
  "rle ''",
  "unrle ''",
  "rle 'bab'",
  "unrle '1b1a1b'",
  "rle 'a'",
  "unrle '1a'",
  "rle 'ccbcb'",
  "unrle '2c1b1c1b'",
  "rle 'caabcbcccbaaca'",
  "unrle '1c2a1b1c1b3c1b2a1c1a'",
  "rle 'bccbcabcabc'",
  "unrle '1b2c1b1c1a1b1c1a1b1c'"]
failedlabels in List(String) := filter((w in String |-> not isnil(w)), zipwith((ok in Bool |-> (name in String |-> if(ok, "", name))), checkvalues, checklabels))
main in String := if(isnil(failedlabels), "PASS 17", "FAIL " ++ unwords(failedlabels))
