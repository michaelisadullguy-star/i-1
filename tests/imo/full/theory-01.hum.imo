  "ienv: p && ¬p",
  "ienv: ¬⟨p || q⟩ <=> ⟨¬p && ¬q⟩",
  "ienv: ¬⟨p && q⟩ => ⟨¬p || ¬q⟩",
  "ienv: ⟨¬p || ¬q⟩ => ¬⟨p && q⟩",
  "ienv: p => ⟨q => p⟩",
  "ienv: ⟨⟨p => q⟩ => p⟩ => ¬¬p",
  "ienv: p || q => q || p",
  "denv: x + 0 = x",
  "denv: x * 1 = x",
  "denv: x * 0 = 0",
  "denv: ⟨x + y⟩^2 = x^2 + 2*x*y + y^2",
  "denv: ⟨x + y⟩^2 = x^2 + y^2",
  "denv: x + 1 = x",
  "denv: 2 + 2 = 4",
  "denv: 2 + 2 = 5",
  "denv: x - x = 0",
  "denv: x / 2 + x / 2 = x",
  "denv: ⟨x - y⟩ * ⟨x + y⟩ = x^2 - y^2",
  "denv: x <= x",
  "denv: x < x",
  "denv: x < y || x = y || x > y",
  "denv: x <= y && y <= x => x = y",
  "denv: x < y => x <= y",
  "denv: x <= y && y <= z => x <= z",
  "denv: x + y <= x + y + 1",
  "denv: x^2 >= 0",
  "denv: x^2 + 1 > 0",
  "denv: x^2 + 1 = 0",
  "denv: x^2 = -1",
  "denv: x * x >= 0",
  "denv: x <= y => x + z <= y + z",
  "denv: x <= y => 2*x <= 2*y",
  "denv: x < y && y < x",
  "denv: x < y && y < z => x < z",
  "denv: x <= y || y <= x",
  "denv: x + y = y + x",
  "denv: x * ⟨y + z⟩ = x * y + x * z",
  "denv: 3/4 + 1/4 = 1",
  "denv: x^3 - x^3 = 0"]
failedlabels in List(String) := filter((w in String |-> not isnil(w)), zipwith((ok in Bool |-> (name in String |-> if(ok, "", name))), checkvalues, checklabels))
main in String := if(isnil(failedlabels), "PASS 150", "FAIL " ++ unwords(failedlabels))
