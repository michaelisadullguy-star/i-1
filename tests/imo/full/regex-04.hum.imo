-- regular expressions: checks 451 to 496 of 496.  Generated by tests/langtest.py from tests/test_regex.py: the expected values were computed by independent Python oracles;
-- run it with  ./i1 --impl NAME run THIS_FILE  on any core: it prints  PASS n  when every check holds, and  FAIL  and the labels of the failed checks otherwise.
checkvalues in List(Bool) := [((rxfull("[^a-b]", "")) iff (false)),
  eqlist((euccf in \NN |-> (evccf in \NN |-> ((euccf) == (evccf)))), rxprefix("[^a-b]", " __c ._"), [1]),
  eqlist((euccg in Pair(\NN, \NN) |-> (evccg in Pair(\NN, \NN) |-> (((fst(euccg)) == (fst(evccg))) and ((snd(euccg)) == (snd(evccg)))))), rxsearch("[^a-b]", " __c ._"), [pair(0, 1)]),
  eqlist((eucch in String |-> (evcch in String |-> ((eucch) == (evcch)))), rxfindall("[^a-b]", " __c ._"), [" ", "_", "_", "c", " ", ".", "_"]),
  ((rxreplace("[^a-b]", "<>", " __c ._")) == ("<><><><><><><>")),
  eqlist((eucci in String |-> (evcci in String |-> ((eucci) == (evcci)))), rxsplit("[^a-b]", " __c ._"), ["", "", "", "", "", "", "", ""]),
  ((rxfull("\\s*", "b")) iff (false)),
  ((rxfull("\\s*", ".")) iff (false)),
  ((rxfull("\\s*", " \n")) iff (true)),
  eqlist((euccj in \NN |-> (evccj in \NN |-> ((euccj) == (evccj)))), rxprefix("\\s*", "1."), [0]),
  eqlist((eucda in Pair(\NN, \NN) |-> (evcda in Pair(\NN, \NN) |-> (((fst(eucda)) == (fst(evcda))) and ((snd(eucda)) == (snd(evcda)))))), rxsearch("\\s*", "1."), [pair(0, 0)]),
  eqlist((eucda in String |-> (evcda in String |-> ((eucda) == (evcda)))), rxfindall("\\s*", "1."), []),
  ((rxreplace("\\s*", "<>", "1.")) == ("1.")),
  eqlist((eucdc in String |-> (evcdc in String |-> ((eucdc) == (evcdc)))), rxsplit("\\s*", "1."), ["1."]),
  ((rxfull(".?", "_aabac_")) iff (false)),
  ((rxfull(".?", "1__ ")) iff (false)),
  ((rxfull(".?", " ._\n\n")) iff (false)),
  eqlist((eucdd in \NN |-> (evcdd in \NN |-> ((eucdd) == (evcdd)))), rxprefix(".?", "1abc .c"), [1]),
  eqlist((eucde in Pair(\NN, \NN) |-> (evcde in Pair(\NN, \NN) |-> (((fst(eucde)) == (fst(evcde))) and ((snd(eucde)) == (snd(evcde)))))), rxsearch(".?", "1abc .c"), [pair(0, 1)]),
  eqlist((eucdf in String |-> (evcdf in String |-> ((eucdf) == (evcdf)))), rxfindall(".?", "1abc .c"), ["1", "a", "b", "c", " ", ".", "c"]),
  ((rxreplace(".?", "<>", "1abc .c")) == ("<><><><><><><>")),
  eqlist((eucdg in String |-> (evcdg in String |-> ((eucdg) == (evcdg)))), rxsplit(".?", "1abc .c"), ["", "", "", "", "", "", "", ""]),
  ((rxfull("([^a-b])?", "_")) iff (true)),
  ((rxfull("([^a-b])?", "cbb\n_b\n")) iff (false)),
  ((rxfull("([^a-b])?", "1")) iff (true)),
  eqlist((eucdh in \NN |-> (evcdh in \NN |-> ((eucdh) == (evcdh)))), rxprefix("([^a-b])?", "\nc.a "), [1]),
  eqlist((eucdi in Pair(\NN, \NN) |-> (evcdi in Pair(\NN, \NN) |-> (((fst(eucdi)) == (fst(evcdi))) and ((snd(eucdi)) == (snd(evcdi)))))), rxsearch("([^a-b])?", "\nc.a "), [pair(0, 1)]),
  eqlist((eucdj in String |-> (evcdj in String |-> ((eucdj) == (evcdj)))), rxfindall("([^a-b])?", "\nc.a "), ["\n", "c", ".", " "]),
  ((rxreplace("([^a-b])?", "<>", "\nc.a ")) == ("<><><>a<>")),
  eqlist((eucea in String |-> (evcea in String |-> ((eucea) == (evcea)))), rxsplit("([^a-b])?", "\nc.a "), ["", "", "", "a", ""]),
  ((rxfull("a*b", "aaab")) iff (true)),
  ((rxfull("a*b", "aaa")) iff (false)),
  ((rxfull("(ab|cd)+", "abcdab")) iff (true)),
  ((rxfull("(ab|cd)+", "abc")) iff (false)),
  ((rxfull("[a-z]+@[a-z]+\\.com", "me@home.com")) iff (true)),
  ((rxfull("\\d\\d-\\d\\d", "12-34")) iff (true)),
  ((rxfull("\\d\\d-\\d\\d", "12-3x")) iff (false)),
  ((rxfull("", "")) iff (true)),
  ((rxfull("", "a")) iff (false)),
  ((rxfull("a?", "")) iff (true)),
  ((rxfull("(a|b)*abb", "ababb")) iff (true)),
  ((rxfull("[^a]*", "bcd")) iff (true)),
  eqlist((eucea in Pair(\NN, \NN) |-> (evcea in Pair(\NN, \NN) |-> (((fst(eucea)) == (fst(evcea))) and ((snd(eucea)) == (snd(evcea)))))), rxsearch("a|ab", "xab"), [pair(1, 2)]),
  eqlist((eucec in String |-> (evcec in String |-> ((eucec) == (evcec)))), rxfindall("a+", "baaab aa"), ["aaa", "aa"]),
  ((rxreplace("\\d+", "#", "a12b345")) == ("a#b#")),
  eqlist((euced in String |-> (evced in String |-> ((euced) == (evced)))), rxsplit(",", "a,b,,c"), ["a", "b", "", "c"])]
checklabels in List(String) := ["rxfull '⟦^a-b⟧' ''",
  "rxprefix '⟦^a-b⟧' ' __c ._'",
  "rxsearch '⟦^a-b⟧' ' __c ._'",
  "rxfindall '⟦^a-b⟧' ' __c ._'",
  "rxreplace '⟦^a-b⟧' ' __c ._'",
  "rxsplit '⟦^a-b⟧' ' __c ._'",
  "rxfull '\\\\s*' 'b'",
  "rxfull '\\\\s*' '.'",
  "rxfull '\\\\s*' ' \\n'",
  "rxprefix '\\\\s*' '1.'",
  "rxsearch '\\\\s*' '1.'",
  "rxfindall '\\\\s*' '1.'",
  "rxreplace '\\\\s*' '1.'",
  "rxsplit '\\\\s*' '1.'",
  "rxfull '.?' '_aabac_'",
  "rxfull '.?' '1__ '",
  "rxfull '.?' ' ._\\n\\n'",
  "rxprefix '.?' '1abc .c'",
  "rxsearch '.?' '1abc .c'",
  "rxfindall '.?' '1abc .c'",
  "rxreplace '.?' '1abc .c'",
  "rxsplit '.?' '1abc .c'",
  "rxfull '⟨⟦^a-b⟧⟩?' '_'",
  "rxfull '⟨⟦^a-b⟧⟩?' 'cbb\\n_b\\n'",
  "rxfull '⟨⟦^a-b⟧⟩?' '1'",
  "rxprefix '⟨⟦^a-b⟧⟩?' '\\nc.a '",
  "rxsearch '⟨⟦^a-b⟧⟩?' '\\nc.a '",
  "rxfindall '⟨⟦^a-b⟧⟩?' '\\nc.a '",
  "rxreplace '⟨⟦^a-b⟧⟩?' '\\nc.a '",
  "rxsplit '⟨⟦^a-b⟧⟩?' '\\nc.a '",
  "rxfull 'a*b' 'aaab'",
  "rxfull 'a*b' 'aaa'",
  "rxfull '⟨ab|cd⟩+' 'abcdab'",
  "rxfull '⟨ab|cd⟩+' 'abc'",
  "rxfull '⟦a-z⟧+@⟦a-z⟧+\\\\.com' 'me@home.com'",
  "rxfull '\\\\d\\\\d-\\\\d\\\\d' '12-34'",
  "rxfull '\\\\d\\\\d-\\\\d\\\\d' '12-3x'",
  "rxfull '' ''",
  "rxfull '' 'a'",
  "rxfull 'a?' ''",
  "rxfull '⟨a|b⟩*abb' 'ababb'",
  "rxfull '⟦^a⟧*' 'bcd'",
  "the leftmost longest match: a|ab on ab",
  "rxfindall a+ on baaab aa",
  "rxreplace ⟦0-9⟧+ by #",
  "rxsplit , on a,b,,c"]
failedlabels in List(String) := filter((w in String |-> not isnil(w)), zipwith((ok in Bool |-> (name in String |-> if(ok, "", name))), checkvalues, checklabels))
main in String := if(isnil(failedlabels), "PASS 46", "FAIL " ++ unwords(failedlabels))
