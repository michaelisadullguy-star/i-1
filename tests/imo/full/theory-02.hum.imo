  "ienv: ⟨⟨⟨r && q⟩ && ⟨q => q⟩⟩ && ⟨⟨r || true⟩ && ⟨false && q⟩⟩⟩",
  "ienv proves? ¬¬⟨⟨⟨⟨r && q⟩ && ⟨q => q⟩⟩ && ⟨⟨r || true⟩ && ⟨false && q⟩⟩⟩⟩",
  "ienv proves? ⟨⟨⟨r && q⟩ && ⟨q => q⟩⟩ && ⟨⟨r || true⟩ && ⟨false && q⟩⟩⟩",
  "denv: ⟨false => ⟨⟨q && true⟩ || ⟨q => r⟩⟩⟩",
  "ienv proves? ¬¬⟨⟨false => ⟨⟨q && true⟩ || ⟨q => r⟩⟩⟩⟩",
  "denv: ⟨⟨¬⟨⟨p || false⟩⟩ xor ⟨⟨p xor q⟩ <=> true⟩⟩ || ⟨⟨⟨q && q⟩ => true⟩ <=> ⟨⟨true || q⟩ => ⟨true || q⟩⟩⟩⟩",
  "ienv proves? ¬¬⟨⟨⟨¬⟨⟨p || false⟩⟩ xor ⟨⟨p xor q⟩ <=> true⟩⟩ || ⟨⟨⟨q && q⟩ => true⟩ <=> ⟨⟨true || q⟩ => ⟨true || q⟩⟩⟩⟩⟩",
  "denv: ⟨⟨⟨⟨q <=> true⟩ => ⟨true <=> q⟩⟩ <=> ⟨⟨q && q⟩ xor p⟩⟩ || ⟨⟨q <=> r⟩ && ¬⟨r⟩⟩⟩",
  "ienv: ⟨⟨⟨⟨q <=> true⟩ => ⟨true <=> q⟩⟩ <=> ⟨⟨q && q⟩ xor p⟩⟩ || ⟨⟨q <=> r⟩ && ¬⟨r⟩⟩⟩"]
failedlabels in List(String) := filter((w in String |-> not isnil(w)), zipwith((ok in Bool |-> (name in String |-> if(ok, "", name))), checkvalues, checklabels))
main in String := if(isnil(failedlabels), "PASS 150", "FAIL " ++ unwords(failedlabels))
