failedlabels in List(String) := filter((w in String |-> not isnil(w)), zipwith((ok in Bool |-> (name in String |-> if(ok, "", name))), checkvalues, checklabels))
main in String := if(isnil(failedlabels), "PASS 144", "FAIL " ++ unwords(failedlabels))
