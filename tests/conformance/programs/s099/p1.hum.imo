x in \RR
main in List(Prop) := [x^2 gt 7 and x^3 lt 27, x^2 + 1 == 0, x^2 - 2 geq 0, (x - 1)*(x - 2)*(x - 3) lt 0, x^3 == 2, x^2 geq 0, x^2 + 1 gt 0, (x gt 1 or x lt -1) and x^2 lt 4, x != 1 and x^2 == 1, x gt 2 implies x^2 gt 4, x^2 == 2 or x == 1, x^2 lt 0, x == x, x == x + 1, x^4 - 5*x^2 + 4 == 0, x^3 - x gt 0, x^5 - x + 1 gt 0, not (x gt 0), (x gt 0) iff (x^3 gt 0)]
