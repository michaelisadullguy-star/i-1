
pi in \RR := sum(2, k in \QQ |-> k / (2 * k + 1))
e in \RR := sum(1, k in \QQ |-> 1 / k)
z in \R := pi + e * i
twice(x) in \R -> Bool := x + x == 2 * x
shifted(x) in \R -> Bool := x == x + 1
ring1 in Bool := pi + e - pi == e
ring2 in Bool := (pi + e) * (pi + e) == pi * pi + 2 * pi * e + e * e
ring3 in Bool := z * conj(z) == pi * pi + e * e
val1 in Bool := 1/3 + 1/6 == 1/2
val2 in Bool := 2 == 3
iso1 in Bool := exp(1) == e
iso2 in Bool := sum(2, j in \QQ |-> j / (1 + 2 * j)) == pi
iso3 in Bool := 4 * atan(1) == pi
exp1 in Bool := e * e == exp(2)
exp2 in Bool := sin(1/2) * sin(1/2) + cos(1/2) * cos(1/2) == 1
exp3 in Bool := exp(i / 2) == cos(1/2) + i * sin(1/2)
exp4 in Bool := cosh(1/3) * cosh(1/3) - sinh(1/3) * sinh(1/3) == 1
sqrt1 in Bool := sqrt(2) * sqrt(2) == 2
sqrt2 in Bool := sqrt(9/4) == 3/2
sqrt3 in Bool := sqrt(3) * sqrt(2) == sqrt(6)
num1 in Bool := pi == e
num2 in Bool := pi gt 3
num3 in Bool := pi lt 22 / 7
num4 in Bool := sqrt(2) lt 1.414
num5 in Bool := pi * pi == 10
log1 in Bool := (pi != e) and (e lt pi)
log2 in Bool := pi + 0 == pi or 1 gt 2
log3 in Bool := not (pi == e) implies (e lt 3)
var1 in Bool := twice(pi)
var2 in Bool := shifted(e)
und1 in Bool := sqrt(8) == 2 * sqrt(2)
