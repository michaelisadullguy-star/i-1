-- the verdict of statements: 1 true for all values, 0 false for all values, 2 undetermined
main in List(\NN) := [holdsv(defaultenv, "(x + y)^2 = x^2 + 2*x*y + y^2"), holdsv(defaultenv, "x^2 + 1 = 0"), holdsv(defaultenv, "x = y"), holdsv(defaultenv, "x <= y && y <= z => x <= z"), holdsv(defaultenv, "((p => q) => p) => p"), holdsv(use("intuitionistic", defaultenv), "((p => q) => p) => p"), holdsv(use("intuitionistic", defaultenv), "p => ¬¬p"), holdsv(envwith(["peano"]), "x = 0 || x > 0"), holdsv(envwith(["group"]), "inv(x · y) = inv(y) · inv(x)"), holdsv(envwith(["abelian"]), "x · y = y · x"), holdsv(envwith(["sets"]), "(A ∪ B)ᶜ = Aᶜ ∩ Bᶜ"), holdsv(envwith(["lattice"]), "x ⊓ (x ⊔ y) = x")]
