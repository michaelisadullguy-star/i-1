main in List(\NN) := map((s in String |-> holdsv(envwith(["topology"]), s)), ["cl(cl(A)) = cl(A)", "int(A) = (cl(Aᶜ))ᶜ", "cl(int(cl(int(A)))) = cl(int(A))", "int(cl(int(cl(A)))) = int(cl(A))", "cl(A) = A ∪ bd(A)", "bd(A) = bd(Aᶜ)", "int(A) ∪ bd(A) ∪ ext(A) = U", "cl(bd(A)) = bd(A)", "open(A) && open(B) => open(A ∩ B)", "closed(A) && closed(B) => closed(A ∪ B)", "cl(A ∩ B) = cl(A) ∩ cl(B)", "cl(A) = int(A)", "(cl(A))ᶜ = cl(A)", "A ⊆ cl(A)"])
