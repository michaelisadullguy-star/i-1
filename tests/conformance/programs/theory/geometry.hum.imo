main in List(\NN) := map((p in Pair(String, String) |-> holdsv(envwith([fst(p)]), snd(p))), [pair("euclid", "rightangle(pt(3/4, 1/4), pt(1/2, 1/4), pt(1/2, 1/2))"), pair("hyperbolic", "rightangle(pt(3/4, 1/4), pt(1/2, 1/4), pt(1/2, 1/2))"), pair("elliptic", "rightangle(pt(3/4, 1/4), pt(1/2, 1/4), pt(1/2, 1/2))"), pair("euclid", "rightangle(pt(0, 0), pt(1/2, 0), pt(1/2, 1/3))"), pair("hyperbolic", "rightangle(pt(0, 0), pt(1/2, 0), pt(1/2, 1/3))"), pair("hyperbolic", "coshsq(pt(0, 0), pt(1/2, 1/3)) = coshsq(pt(0, 0), pt(1/2, 0)) * coshsq(pt(1/2, 0), pt(1/2, 1/3))"), pair("elliptic", "cossq(pt(0, 0), pt(1/2, 1/3)) = cossq(pt(0, 0), pt(1/2, 0)) * cossq(pt(1/2, 0), pt(1/2, 1/3))"), pair("euclid", "perp(A, B, B, C) => dist2(A, C) = dist2(A, B) + dist2(B, C)"), pair("euclid", "oncircle(C, midpoint(A, B), A) => rightangle(A, C, B)"), pair("euclid", "same(fourth(midpoint(A, B), midpoint(B, C), midpoint(C, D)), midpoint(D, A))"), pair("euclid", "collinear(A, midpoint(B, C), centroid(A, B, C))"), pair("euclid", "dist2(A, B) + dist2(A, C) = 2 * dist2(A, midpoint(B, C)) + dist2(B, C) / 2"), pair("hilbert", "dist2(A, B) > 0 => between(A, midpoint(A, B), B)"), pair("euclid", "cong(A, B, C, D)"), pair("incidence", "collinear(A, B, C) <=> collinear(C, A, B)")])
