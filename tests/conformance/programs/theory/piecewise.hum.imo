main in List(\NN) := map((s in String |-> holdsv(envwith(["piecewise"]), s)), ["abs(x + y) <= abs(x) + abs(y)", "abs(x) - abs(y) <= abs(x - y)", "max(x, y) = (x + y + abs(x - y)) / 2", "abs(x) = x", "abs(x) < 0", "max(x, y) <= z <=> (x <= z && y <= z)", "sgn(x) * abs(x) = x", "min(x, max(x, y)) = x", "(x + 1)^2 >= 0", "x^2 + x + 1 > 0", "x^2 + 2*x + 1 > 0", "x^2 + y^2 >= 2*x*y", "x^2 + 2*x + 2 < 0", "a^2 + b^2 + c^2 >= a*b + b*c + c*a"])
