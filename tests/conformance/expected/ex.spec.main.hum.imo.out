π ∶ ℝ
π ≔ (Σ 1100 (k ∶ ℚ ↦ (÷ k (⊞ (⊠ 1100 k) 1))))
x ∶ ℚ[i]
x ≔ (÷ (⊞ 1 (⊠ 1100 11)) (⊟ 1101 11))
main ∶ 𝕊
main ≔ (unlines (∷ (⧺ "x        = " (showc x)) (∷ (⧺ "|x|^2    = " (showq (𝒩 x))) (∷ (⧺ "x in base i-1: numerator " (⧺ (bits (numer x)) (⧺ ", denominator " (bits (denom x))))) (∷ (⧺ "pi_20    = " (showq (nth π 110011010000))) (∷ (⧺ "         ~ " (decimals (nth π 110011010000) 100010000)) (∷ (⧺ "sqrt 2   ~ " (decimals (nth (√ 1100) 110111000000) 100010000)) (∷ (⧺ "100!     = " (dec (fact 11101110111010000))) (∷ (⧺ "gcd(84, 36) = " (⧺ (dec (gcd 11101110011010000 110111010000)) (⧺ ",  2^64 = " (dec (^ 1100 11101000000000000))))) ⊘)))))))))
